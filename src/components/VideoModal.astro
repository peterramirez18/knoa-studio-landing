---
import Button from "./Button.astro";
---

<div
  id="video-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 px-4 py-6 opacity-0 transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="video-modal-title"
  data-video-modal
>
  <button
    type="button"
    class="absolute inset-0 cursor-default"
    aria-label="Close video"
    data-video-modal-close
  ></button>

  <div class="relative z-10 w-full max-w-6xl translate-y-4 overflow-hidden rounded-2xl bg-black shadow-2xl shadow-black/40 transition-transform duration-300" data-video-modal-panel>
    <div class="flex items-center justify-between gap-4 border-b border-white/10 px-4 py-3 sm:px-5">
      <h2 id="video-modal-title" class="text-sm font-bold uppercase tracking-[0.16em] text-white/70" data-video-modal-title>
        Video
      </h2>
      <Button type="button" variant="white" size="icon" videoModalClose ariaLabel="Close video">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </Button>
    </div>
    <div class="aspect-video bg-black">
      <video
        class="h-full w-full object-contain"
        controls
        playsinline
        preload="metadata"
        data-video-modal-player
      ></video>
    </div>
  </div>
</div>

<script>
  const modal = document.querySelector<HTMLElement>('[data-video-modal]');
  const panel = document.querySelector<HTMLElement>('[data-video-modal-panel]');
  const player = document.querySelector<HTMLVideoElement>('[data-video-modal-player]');
  const title = document.querySelector<HTMLElement>('[data-video-modal-title]');
  const openers = document.querySelectorAll<HTMLElement>('[data-video-modal-open]');
  const closers = document.querySelectorAll<HTMLElement>('[data-video-modal-close]');
  let lastFocused: HTMLElement | null = null;

  function openVideo(src: string, label: string) {
    if (!modal || !player) return;
    lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    if (title) title.textContent = label || 'Video';
    player.src = src;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.classList.add('overflow-hidden');
    requestAnimationFrame(() => {
      modal.classList.remove('opacity-0');
      panel?.classList.remove('translate-y-4');
      player.play().catch(() => undefined);
    });
  }

  function closeVideo() {
    if (!modal || !player) return;
    player.pause();
    player.removeAttribute('src');
    player.load();
    modal.classList.add('opacity-0');
    panel?.classList.add('translate-y-4');
    document.body.classList.remove('overflow-hidden');
    window.setTimeout(() => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      lastFocused?.focus();
    }, 300);
  }

  openers.forEach((opener) => {
    opener.addEventListener('click', () => {
      const src = opener.dataset.videoSrc;
      if (!src) return;
      openVideo(src, opener.dataset.videoTitle || opener.textContent?.trim() || 'Video');
    });
  });

  closers.forEach((closer) => closer.addEventListener('click', closeVideo));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeVideo();
  });
</script>