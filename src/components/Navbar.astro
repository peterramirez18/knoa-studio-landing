---
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-18">
      <!-- Logo -->
      <a href="#" class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-lg bg-[var(--color-text)] flex items-center justify-center">
          <span class="text-white font-display font-bold text-sm">K</span>
        </div>
        <span class="font-display font-semibold text-lg text-[var(--color-text)] tracking-tight">Knoa Studio</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-8">
        <a href="#services" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors duration-200">Services</a>
        <a href="#process" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors duration-200">Process</a>
        <a href="#case-studies" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors duration-200">Case Studies</a>
        <a href="#footer" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors duration-200">Company</a>
        <a href="#cta" class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-[var(--color-text)] rounded-full hover:bg-[var(--color-accent)] transition-all duration-300">
          Contact
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7v10" /></svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Toggle menu">
        <span class="block w-5 h-0.5 bg-[var(--color-text)] transition-all duration-300 origin-center" id="menu-line-1"></span>
        <span class="block w-5 h-0.5 bg-[var(--color-text)] transition-all duration-300" id="menu-line-2"></span>
        <span class="block w-3.5 h-0.5 bg-[var(--color-text)] transition-all duration-300 origin-center" id="menu-line-3"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white/95 backdrop-blur-xl border-t border-[var(--color-border)]">
    <div class="px-6 py-6 flex flex-col gap-4">
      <a href="#services" class="text-base text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors py-2">Services</a>
      <a href="#process" class="text-base text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors py-2">Process</a>
      <a href="#case-studies" class="text-base text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors py-2">Case Studies</a>
      <a href="#footer" class="text-base text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors py-2">Company</a>
      <a href="#cta" class="inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-medium text-white bg-[var(--color-text)] rounded-full hover:bg-[var(--color-accent)] transition-all duration-300 mt-2">
        Contact
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7v10" /></svg>
      </a>
    </div>
  </div>
</nav>

<script>
  // Navbar scroll effect
  const navbar = document.getElementById('navbar');
  let lastScroll = 0;

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    if (currentScroll > 50) {
      navbar?.classList.add('bg-white/80', 'backdrop-blur-xl', 'border-b', 'border-[var(--color-border)]', 'shadow-sm');
    } else {
      navbar?.classList.remove('bg-white/80', 'backdrop-blur-xl', 'border-b', 'border-[var(--color-border)]', 'shadow-sm');
    }
    lastScroll = currentScroll;
  });

  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  let isOpen = false;

  mobileMenuBtn?.addEventListener('click', () => {
    isOpen = !isOpen;
    mobileMenu?.classList.toggle('hidden');
    const l1 = document.getElementById('menu-line-1');
    const l2 = document.getElementById('menu-line-2');
    const l3 = document.getElementById('menu-line-3');
    if (isOpen) {
      l1?.classList.add('rotate-45', 'translate-y-[4px]');
      l2?.classList.add('opacity-0');
      l3?.classList.add('-rotate-45', '-translate-y-[4px]', 'w-5');
    } else {
      l1?.classList.remove('rotate-45', 'translate-y-[4px]');
      l2?.classList.remove('opacity-0');
      l3?.classList.remove('-rotate-45', '-translate-y-[4px]', 'w-5');
    }
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      isOpen = false;
    });
  });
</script>
