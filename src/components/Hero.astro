---
import type { Dictionary } from "../i18n";
import { Image } from "astro:assets";
import Button from "./Button.astro";
import parqueameImage from "../assets/projects/parqueameapp.png";
import minqikImage from "../assets/projects/minqik.png";
import bciImage from "../assets/projects/bci.png";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section id="hero" class="relative overflow-hidden bg-[#101010] px-6 pb-4 pt-28 text-white sm:pb-12 lg:px-8 lg:pt-32">
  <canvas id="hero-particles" aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full"></canvas>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,#101010_85%)]"></div>
  <div class="relative mx-auto w-full max-w-6xl lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <p class="mb-5 hidden text-lg font-medium text-white/65 sm:block">KNOA Studio</p>
      <h1 class="hero-title mb-4 font-display text-[1.75rem] font-medium leading-[1.16] tracking-normal opacity-0 translate-y-6 sm:text-4xl lg:text-5xl">
        {t.hero.title}
      </h1>
      <p class="hero-subtitle mx-auto max-w-2xl text-sm leading-relaxed text-white/65 opacity-0 translate-y-6 sm:text-base lg:text-lg">
        {t.hero.subtitle}
      </p>
      <div class="hero-cta mt-6 flex flex-wrap items-center justify-center gap-3 opacity-0 translate-y-6 [&>a]:px-4 [&>button]:px-4 sm:[&>a]:px-6 sm:[&>button]:px-6">
        <Button href="#case-studies" variant="white" size="md">{t.hero.cta}</Button>
        <Button videoModalSrc="/knoa-studio-demo-reel-2026.mp4" videoModalTitle="Knoa Studio Demoreel" variant="light" size="md">{t.hero.demoreel}</Button>
      </div>
    </div>

    <div class="hero-visual mt-8 grid gap-3 opacity-0 translate-y-6 sm:mt-10 sm:grid-cols-3">
      {[
        { image: parqueameImage, title: "Parqueame App", href: "https://www.parqueameapp.com" },
        { image: minqikImage, title: "Minqik", href: "https://www.minqik.com" },
        { image: bciImage, title: "BCI", href: "https://bci.com.do" },
      ].map((project, index) => (
        <a href={project.href} target="_blank" rel="noopener noreferrer" aria-label={project.title} class:list={["hero-project group relative overflow-hidden rounded-lg ring-1 ring-white/10 transition duration-300 ease-out hover:-translate-y-1 hover:ring-[var(--color-accent)] hover:shadow-[0_12px_32px_-12px_rgba(248,84,59,0.55)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-accent)]", index > 0 ? "hidden sm:block" : "block"]}>
          <Image src={project.image} alt={project.title} loading="eager" decoding="async" class="aspect-video w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04] group-focus-visible:scale-[1.04]" />
          <span class="absolute bottom-3 left-3 bg-[#101010]/85 px-3 py-1 text-xs font-medium text-white sm:bottom-4 sm:left-4">{project.title}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  // Interactive particle field: particles drift, get pushed away by the cursor,
  // and connect with orange lines near it.
  const hero = document.querySelector<HTMLElement>("#hero");
  const canvas = document.querySelector<HTMLCanvasElement>("#hero-particles");
  const ctx = canvas?.getContext("2d");

  if (hero && canvas && ctx) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ACCENT = "248, 84, 59";
    const LINK_DIST = 130;
    const MOUSE_RADIUS = 230;
    type P = { x: number; y: number; vx: number; vy: number; r: number; hot: boolean };

    let w = 0;
    let h = 0;
    let dpr = 1;
    let particles: P[] = [];
    let raf = 0;
    let visible = true;
    const mouse = { x: -9999, y: -9999, active: false };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = hero.clientWidth;
      h = hero.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(230, Math.floor((w * h) / 6000));
      particles = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25,
        r: Math.random() * 1.6 + 0.8,
        hot: Math.random() < 0.28,
      }));
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);

      if (mouse.active) {
        const glow = ctx.createRadialGradient(mouse.x, mouse.y, 0, mouse.x, mouse.y, MOUSE_RADIUS);
        glow.addColorStop(0, `rgba(${ACCENT}, 0.22)`);
        glow.addColorStop(1, `rgba(${ACCENT}, 0)`);
        ctx.fillStyle = glow;
        ctx.fillRect(0, 0, w, h);
      }

      for (const p of particles) {
        if (!reduced) {
          const dx = p.x - mouse.x;
          const dy = p.y - mouse.y;
          const d2 = dx * dx + dy * dy;
          if (mouse.active && d2 < MOUSE_RADIUS * MOUSE_RADIUS && d2 > 0.01) {
            const d = Math.sqrt(d2);
            const force = (1 - d / MOUSE_RADIUS) * 1.6;
            p.vx += (dx / d) * force;
            p.vy += (dy / d) * force;
          }
          p.vx *= 0.96;
          p.vy *= 0.96;
          p.x += p.vx + (Math.random() - 0.5) * 0.04;
          p.y += p.vy + (Math.random() - 0.5) * 0.04;
          if (p.x < 0) p.x = w;
          else if (p.x > w) p.x = 0;
          if (p.y < 0) p.y = h;
          else if (p.y > h) p.y = 0;
        }

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = p.hot ? `rgba(${ACCENT}, 0.9)` : "rgba(255, 255, 255, 0.6)";
        ctx.fill();
      }

      // Links between nearby particles; brighter orange close to the cursor.
      for (let i = 0; i < particles.length; i++) {
        const a = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const b = particles[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 > LINK_DIST * LINK_DIST) continue;
          const mx = (a.x + b.x) / 2 - mouse.x;
          const my = (a.y + b.y) / 2 - mouse.y;
          const near = mouse.active && mx * mx + my * my < MOUSE_RADIUS * MOUSE_RADIUS * 2.2;
          const alpha = (1 - Math.sqrt(d2) / LINK_DIST) * (near ? 0.95 : 0.2);
          ctx.strokeStyle = near ? `rgba(${ACCENT}, ${alpha})` : `rgba(255, 255, 255, ${alpha})`;
          ctx.lineWidth = near ? 1.4 : 0.7;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }
    };

    const loop = () => {
      if (visible) draw();
      raf = requestAnimationFrame(loop);
    };

    resize();
    if (reduced) {
      draw();
    } else {
      loop();
      new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(hero);
      hero.addEventListener("pointermove", (e) => {
        const b = hero.getBoundingClientRect();
        mouse.x = e.clientX - b.left;
        mouse.y = e.clientY - b.top;
        mouse.active = true;
      });
      hero.addEventListener("pointerleave", () => (mouse.active = false));
    }

    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        if (reduced) draw();
      }, 150);
    });
  }
</script>

<script>
  import gsap from "gsap";

  const motionAllowed = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (motionAllowed) {
    requestAnimationFrame(() => {
      gsap.to(".hero-title, .hero-subtitle, .hero-cta, .hero-visual", {
        y: 0,
        opacity: 1,
        duration: 0.8,
        stagger: 0.1,
        ease: "power3.out",
      });
    });
  }
</script>
