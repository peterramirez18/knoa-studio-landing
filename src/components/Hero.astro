---
import type { Dictionary } from "../i18n";
import Button from "./Button.astro";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section
  id="hero"
  class="relative min-h-screen overflow-hidden bg-[#0c0c0c] px-6 pb-20 pt-32 text-white lg:px-8"
>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_20%,rgba(248,84,59,0.28),transparent_30%),radial-gradient(circle_at_82%_12%,rgba(255,255,255,0.12),transparent_24%),linear-gradient(135deg,#0c0c0c_0%,#151515_52%,#070707_100%)]"></div>
  <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-black/75 to-transparent"></div>

  <div class="relative z-10 mx-auto flex w-full max-w-7xl flex-col items-center">
    <div class="mb-12 w-full text-center lg:mb-14">
      <h1 class="hero-title mx-auto mb-6 max-w-[16ch] font-display text-[clamp(3.2rem,7.4vw,7.6rem)] font-bold leading-[0.9] tracking-tighter text-white opacity-0 translate-y-12">
        {t.hero.title}
      </h1>
      <p class="hero-subtitle mx-auto max-w-3xl text-lg font-medium text-white/76 opacity-0 translate-y-8 lg:text-2xl">
        {t.hero.subtitle}
      </p>
    </div>

    <div class="hero-visual mb-12 w-full max-w-5xl opacity-0 translate-y-10">
      <div class="relative overflow-hidden rounded-[1.6rem] border border-white/12 bg-[#101216] p-4 shadow-[0_2rem_7rem_rgba(0,0,0,0.55)] md:p-5">
        <div class="flex items-center justify-between border-b border-white/10 pb-4">
          <div class="flex items-center gap-3">
            <span class="grid size-10 place-items-center rounded-xl bg-[var(--color-accent)] text-sm font-black">K</span>
            <div>
              <p class="text-sm font-bold leading-none">Knoa Product OS</p>
              <p class="mt-1 text-[0.68rem] font-bold uppercase tracking-[0.16em] text-white/35">Strategy / Design / Development</p>
            </div>
          </div>
          <div class="hidden items-center gap-2 sm:flex">
            <span class="h-2 w-2 rounded-full bg-emerald-300"></span>
            <span class="text-xs font-bold uppercase tracking-[0.14em] text-white/45">Live build</span>
          </div>
        </div>

        <div class="grid gap-4 pt-4 lg:grid-cols-[0.76fr_1.24fr]">
          <div class="grid gap-4">
            {["Product strategy", "UX/UI system", "Frontend build"].map((item, index) => (
              <div class:list={["rounded-2xl border p-4", index === 0 ? "border-white bg-white text-black" : "border-white/10 bg-white/6 text-white"]}>
                <p class:list={["text-[0.68rem] font-bold uppercase tracking-[0.14em]", index === 0 ? "text-black/42" : "text-white/35"]}>{item}</p>
                <div class="mt-4 flex items-center gap-2">
                  <span class:list={["h-2 rounded-full", index === 0 ? "w-24 bg-[var(--color-accent)]" : "w-20 bg-white/45"]}></span>
                  <span class:list={["h-2 rounded-full", index === 0 ? "w-14 bg-black/12" : "w-16 bg-white/16"]}></span>
                </div>
              </div>
            ))}
          </div>

          <div class="rounded-2xl border border-white/10 bg-white p-5 text-black">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.16em] text-black/40">Digital product</p>
                <h2 class="mt-2 max-w-md text-3xl font-black leading-[0.95] tracking-[-0.04em] md:text-5xl">From idea to usable platform.</h2>
              </div>
              <span class="rounded-full bg-black px-3 py-1 text-xs font-black uppercase tracking-[0.12em] text-white">v1 ready</span>
            </div>

            <div class="mt-8 grid gap-4 sm:grid-cols-3">
              {[
                { label: "Flows", value: "18" },
                { label: "Screens", value: "42" },
                { label: "Core features", value: "9" },
              ].map((metric) => (
                <div class="rounded-xl border border-black/10 p-4">
                  <p class="text-[0.68rem] font-bold uppercase tracking-[0.14em] text-black/40">{metric.label}</p>
                  <p class="mt-2 text-3xl font-black tracking-[-0.04em]">{metric.value}</p>
                </div>
              ))}
            </div>

            <div class="mt-6 grid gap-3">
              {[86, 64, 74].map((width, index) => (
                <div class="overflow-hidden rounded-full bg-black/8">
                  <span class:list={["block h-3 rounded-full", index === 0 ? "bg-[var(--color-accent)]" : "bg-black"]} style={`width:${width}%`}></span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-cta flex flex-col items-center gap-3 opacity-0 translate-y-8 sm:flex-row">
      <Button href="#case-studies" variant="light" size="lg">
        {t.hero.cta}
      </Button>
      <Button videoModalSrc="/knoa-studio-demo-reel-2026.mp4" videoModalTitle="Knoa Studio Demoreel" variant="white" size="lg">
        {t.hero.demoreel}
      </Button>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";

  requestAnimationFrame(() => {
    const tl = gsap.timeline({ defaults: { ease: "power4.out" } });

    tl.to(".hero-title", { y: 0, opacity: 1, duration: 1.2, delay: 0.1 })
      .to(".hero-subtitle", { y: 0, opacity: 1, duration: 1 }, "-=0.9")
      .to(".hero-visual", { scale: 1, opacity: 1, duration: 1.4, ease: "power3.inOut" }, "-=0.8")
      .to(".hero-cta", { y: 0, opacity: 1, duration: 0.8 }, "-=0.6");
  });
</script>
