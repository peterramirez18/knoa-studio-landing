---
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const cases = t.useCases.items;
---

<section id="use-cases" class="relative py-24 lg:py-40 bg-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-24">
      <div class="lg:col-span-5 uc-fade opacity-0 translate-y-12">
        <h2 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl tracking-tight text-[var(--color-text)] mb-6 sticky top-40">
          {t.useCases.title}
        </h2>
      </div>

      <div class="lg:col-span-7">
        <div class="flex flex-col border-b border-[var(--color-border)]">
          {cases.map((item) => (
            <div class="uc-accordion-item border-t border-[var(--color-border)] group cursor-pointer overflow-hidden">
              <div class="uc-accordion-header flex items-center justify-between py-6 lg:py-8 transition-colors duration-300 group-hover:text-[var(--color-accent)]">
                <h3 class="font-display font-bold text-2xl lg:text-4xl text-[var(--color-text)] transition-colors duration-300 group-hover:text-[var(--color-accent)] pointer-events-none">
                  {item.title}
                </h3>
                <div class="w-10 h-10 rounded-full border border-[var(--color-border)] flex items-center justify-center transition-all duration-300 group-hover:border-[var(--color-accent)] group-hover:rotate-180 uc-icon relative pointer-events-none">
                  <span class="w-4 h-px bg-current absolute"></span>
                  <span class="w-px h-4 bg-current absolute uc-icon-v transition-transform duration-300"></span>
                </div>
              </div>

              <div class="uc-accordion-content h-0 overflow-hidden">
                <div class="pb-8 pt-2">
                  <p class="text-lg lg:text-xl text-[var(--color-text-secondary)] font-medium leading-relaxed max-w-2xl">
                    {item.description}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .uc-accordion-item.is-open .uc-icon-v { transform: scaleY(0); }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  requestAnimationFrame(() => {
    gsap.to('.uc-fade', { scrollTrigger: { trigger: '#use-cases', start: 'top 75%', once: true }, opacity: 1, y: 0, duration: 1, ease: 'power3.out' });

    gsap.fromTo('.uc-accordion-item', { opacity: 0, y: 30 }, { scrollTrigger: { trigger: '.uc-accordion-item', start: 'top 85%', once: true }, opacity: 1, y: 0, duration: 0.8, stagger: 0.1, ease: 'power3.out' });

    const items = document.querySelectorAll('.uc-accordion-item');
    items.forEach(item => {
      const header = item.querySelector('.uc-accordion-header') as HTMLElement;
      const content = item.querySelector('.uc-accordion-content') as HTMLElement;

      header.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        items.forEach(otherItem => {
          if (otherItem !== item && otherItem.classList.contains('is-open')) {
            otherItem.classList.remove('is-open');
            gsap.to(otherItem.querySelector('.uc-accordion-content'), { height: 0, duration: 0.5, ease: 'power3.inOut' });
          }
        });

        if (isOpen) {
          item.classList.remove('is-open');
          gsap.to(content, { height: 0, duration: 0.5, ease: 'power3.inOut' });
        } else {
          item.classList.add('is-open');
          gsap.set(content, { height: 'auto' });
          const height = content.offsetHeight;
          gsap.set(content, { height: 0 });
          gsap.to(content, { height: height, duration: 0.5, ease: 'power3.inOut' });
        }
      });
    });
  });
</script>
