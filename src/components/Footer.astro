---
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const footerLinks = [
  { label: t.nav.about, href: "#about" },
  { label: t.nav.work, href: "#case-studies" },
  { label: t.nav.services, href: "#services" },
  { label: t.nav.process, href: "#process" },
];
const serviceTags = [t.footer.launchVideos, t.footer.landingPages, t.footer.webDevelopment];
const socialLinks = ["LinkedIn", "Instagram", "Behance"];
---

<footer id="footer" class="bg-[#101010] text-white">
  <div class="mx-auto max-w-7xl px-6 py-14 lg:px-8 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
      <div class="max-w-2xl">
        <a href="#hero" class="mb-8 inline-flex w-fit items-center" aria-label="Knoa Studio">
          <img src="/logo-knoa-dark.svg" alt="Knoa Studio" class="w-48 h-auto" />
        </a>

        <p class="mb-8 text-xs font-bold uppercase tracking-[0.18em] text-white/35">
          {t.footer.studioLabel}
        </p>
        <h2 class="max-w-[12ch] font-display text-[clamp(2.8rem,7vw,5.8rem)] font-bold leading-[0.9] tracking-[-0.055em]">
          {t.footer.headline}
        </h2>
      </div>

      <div class="grid gap-10 sm:grid-cols-2">
        <div>
          <p class="mb-4 text-sm leading-relaxed text-white/55">
            {t.footer.subheadline}
          </p>
          <a
            href="#contact"
            data-contact-modal-open
            class="group relative inline-flex items-center justify-center isolation-auto overflow-hidden rounded-full border-2 border-white bg-transparent px-10 py-5 text-xl font-bold text-white transition-colors duration-500 hover:border-transparent hover:text-white"
          >
            <span class="absolute inset-0 -z-10 h-full w-full -translate-y-full rounded-full bg-[var(--color-accent)] transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:translate-y-0"></span>
            {t.cta.button}
          </a>
        </div>

        <div class="grid grid-cols-2 gap-8 sm:grid-cols-1">
          <div>
            <p class="mb-4 text-xs font-bold uppercase tracking-[0.16em] text-white/35">{t.footer.navLabel}</p>
            <nav class="grid gap-2">
              {footerLinks.map((link) => (
                <a href={link.href} class="text-sm font-semibold text-white/60 transition-colors duration-300 hover:text-white">
                  {link.label}
                </a>
              ))}
            </nav>
          </div>

          <div>
            <p class="mb-4 text-xs font-bold uppercase tracking-[0.16em] text-white/35">{t.footer.socialLabel}</p>
            <div class="grid gap-2">
              {socialLinks.map((label) => (
                <a href="#" class="text-sm font-semibold text-white/60 transition-colors duration-300 hover:text-white">
                  {label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-white/12 pt-6">
      <div class="mb-6 flex flex-wrap gap-2">
        {serviceTags.map((tag) => (
          <span class="rounded-full border border-white/12 px-3 py-1 text-[0.7rem] font-bold uppercase tracking-[0.14em] text-white/40">
            {tag}
          </span>
        ))}
      </div>

      <div class="flex flex-col gap-3 text-xs text-white/40 md:flex-row md:items-center md:justify-between">
        <p>{t.footer.copyright}</p>
        <a href="#hero" class="w-fit font-bold uppercase tracking-[0.16em] text-white/55 transition-colors duration-300 hover:text-white">
          {t.footer.top}
        </a>
      </div>
    </div>
  </div>
</footer>
