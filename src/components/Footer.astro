---
---

<footer id="footer" class="relative pt-16 pb-8 bg-white">
  <!-- Top border -->
  <div class="absolute top-0 left-6 right-6 lg:left-8 lg:right-8 h-px bg-[var(--color-border)]"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid md:grid-cols-5 gap-12 lg:gap-16 mb-16">
      <!-- Brand -->
      <div class="md:col-span-2">
        <a href="#" class="flex items-center gap-2 mb-5">
          <div class="w-8 h-8 rounded-lg bg-[var(--color-text)] flex items-center justify-center">
            <span class="text-white font-display font-bold text-sm">K</span>
          </div>
          <span class="font-display font-semibold text-lg text-[var(--color-text)] tracking-tight">Knoa Studio</span>
        </a>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed max-w-xs mb-6">
          We combine motion, design, and development to build launch experiences that turn attention into revenue.
        </p>
        <!-- Social links -->
        <div class="flex items-center gap-3">
          <a href="#" class="w-9 h-9 rounded-lg border border-[var(--color-border)] flex items-center justify-center text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-text-muted)] transition-all duration-300" aria-label="Twitter / X">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="#" class="w-9 h-9 rounded-lg border border-[var(--color-border)] flex items-center justify-center text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-text-muted)] transition-all duration-300" aria-label="Instagram">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="#" class="w-9 h-9 rounded-lg border border-[var(--color-border)] flex items-center justify-center text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-text-muted)] transition-all duration-300" aria-label="LinkedIn">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="#" class="w-9 h-9 rounded-lg border border-[var(--color-border)] flex items-center justify-center text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-text-muted)] transition-all duration-300" aria-label="Dribbble">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 24C5.385 24 0 18.615 0 12S5.385 0 12 0s12 5.385 12 12-5.385 12-12 12zm10.12-10.358c-.35-.11-3.17-.953-6.384-.438 1.34 3.684 1.887 6.684 1.992 7.308 2.3-1.555 3.936-4.02 4.395-6.87zm-6.115 7.808c-.153-.9-.75-4.032-2.19-7.77l-.066.02c-5.79 2.015-7.86 6.025-8.04 6.4 1.73 1.358 3.92 2.166 6.29 2.166 1.42 0 2.77-.29 4-.814zm-11.62-2.58c.232-.4 3.045-5.055 8.332-6.765.135-.045.27-.084.405-.12-.26-.585-.54-1.167-.832-1.74C7.17 11.775 2.206 11.71 1.756 11.7l-.004.312c0 2.633.998 5.037 2.634 6.855zm-2.42-8.955c.46.008 4.683.026 9.477-1.248-1.698-3.018-3.53-5.558-3.8-5.928-2.868 1.35-5.01 3.99-5.676 7.17zM9.6 2.052c.282.38 2.145 2.914 3.822 6 3.645-1.365 5.19-3.44 5.373-3.702C16.86 2.61 14.545 1.62 12 1.62c-.83 0-1.634.1-2.4.285v.146zm10.14 3.504c-.225.3-1.905 2.532-5.692 4.063.244.49.477.988.7 1.49.075.17.148.34.22.51 3.407-.428 6.793.265 7.125.338-.02-2.435-.933-4.66-2.352-6.4z"/></svg>
          </a>
        </div>
      </div>

      <!-- Link columns -->
      <div>
        <h4 class="font-display font-semibold text-sm text-[var(--color-text)] mb-4">Services</h4>
        <ul class="space-y-3">
          <li><a href="#services" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors duration-200">Launch Videos</a></li>
          <li><a href="#services" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors duration-200">Landing Pages</a></li>
          <li><a href="#services" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors duration-200">Web Development</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-display font-semibold text-sm text-[var(--color-text)] mb-4">Company</h4>
        <ul class="space-y-3">
          <li><a href="#" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors duration-200">About</a></li>
          <li><a href="#case-studies" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors duration-200">Case Studies</a></li>
          <li><a href="#process" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors duration-200">Process</a></li>
          <li><a href="#" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors duration-200">Careers</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-display font-semibold text-sm text-[var(--color-text)] mb-4">Contact</h4>
        <ul class="space-y-3">
          <li><a href="mailto:hello@knoastudio.com" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors duration-200">hello@knoastudio.com</a></li>
          <li><a href="#cta" class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors duration-200">Start a Project</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-[var(--color-border)]">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-xs text-[var(--color-text-muted)]">© 2025 Knoa Studio. All rights reserved.</p>
        <div class="flex items-center gap-6">
          <a href="#" class="text-xs text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors duration-200">Privacy Policy</a>
          <a href="#" class="text-xs text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors duration-200">Terms of Service</a>
        </div>
      </div>
    </div>
  </div>
</footer>
