---
const services = [
  {
    id: "services-video",
    title: "Product & Service Launch Videos",
    description: "Cinematic, story-driven videos that capture your product's value in seconds and make audiences feel something.",
    visual: "bg-black",
    accent: "text-indigo-600"
  },
  {
    id: "services-landing",
    title: "High-Impact Landing Pages",
    description: "Conversion-focused pages with strategic structure, premium design, and animations that guide visitors to action.",
    visual: "bg-black",
    accent: "text-sky-600"
  },
  {
    id: "services-web",
    title: "Web Development",
    description: "Performant, accessible, and beautifully engineered web experiences built with modern technologies and best practices.",
    visual: "bg-black",
    accent: "text-emerald-600"
  }
];
---

<section id="services" class="relative bg-white py-24 lg:py-40">
  <!-- Top border -->
  <div class="absolute top-0 left-6 right-6 lg:left-8 lg:right-8 h-px bg-[var(--color-border)]"></div>

  <!-- Header -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 mb-16 lg:mb-32">
    <h2 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl tracking-tight text-[var(--color-text)] max-w-3xl services-title opacity-0 translate-y-12">
      The Power of Our Approach
    </h2>
  </div>

  <!-- Sticky Scroll Container -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-24 relative items-start">
      
      <!-- Left: Sticky Navigation -->
      <div class="lg:sticky lg:top-40 hidden lg:block z-20">
        <ul class="flex flex-col gap-8 relative">
          <!-- Active highlight line -->
          <div class="absolute left-0 top-2 bottom-2 w-px bg-[var(--color-border-light)] z-[-1]"></div>
          <div class="absolute left-0 top-2 w-px bg-[var(--color-accent)] z-0 transition-all duration-300 services-progress" style="height: 33%;"></div>

          {services.map((service, index) => (
            <li class="pl-8">
              <button 
                class="service-nav-btn text-left group w-full"
                data-index={index}
                data-target={`#${service.id}`}
              >
                <h3 class="font-display font-bold text-3xl lg:text-4xl transition-colors duration-300 text-[var(--color-text-muted)] group-[.active]:text-[var(--color-accent)]">
                  {service.title}
                </h3>
              </button>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right: Scrolling Content (Mobile: Default Stack) -->
      <div class="flex flex-col gap-24 lg:gap-[50vh] services-content-wrap pb-[20vh]">
        {services.map((service, index) => (
          <div id={service.id} class="service-panel opacity-0 translate-y-24 transition-all duration-700 w-full" data-index={index}>
            <!-- Mobile Title -->
            <h3 class="lg:hidden font-display font-bold text-3xl mb-6 text-[var(--color-text)]">
              {service.title}
            </h3>
            
            <!-- Visual Container -->
            <div class={`w-full aspect-square md:aspect-[4/3] rounded-2xl ${service.visual} border border-[var(--color-border)] shadow-xl shadow-black/5 mb-8 flex items-center justify-center overflow-hidden relative group`}>
              {/* <!-- Placeholder visual depending on index --> */}
              
            </div>

            <!-- Description -->
            <p class="text-lg lg:text-xl text-[var(--color-text-secondary)] font-medium leading-relaxed">
              {service.description}
            </p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  requestAnimationFrame(() => {
    // Title animation
    gsap.to('.services-title', {
      scrollTrigger: { trigger: '#services', start: 'top 75%', once: true },
      opacity: 1, y: 0, duration: 1, ease: 'power3.out'
    });

    // Sticky Scroll Logic
    const panels = gsap.utils.toArray('.service-panel') as HTMLElement[];
    const navBtns = gsap.utils.toArray('.service-nav-btn') as HTMLElement[];
    const progressBar = document.querySelector('.services-progress') as HTMLElement;

    if (panels.length === 0) return;

    // Set first active
    navBtns[0]?.classList.add('active');
    panels[0].classList.remove('opacity-0', 'translate-y-24');

    panels.forEach((panel, i) => {
      ScrollTrigger.create({
        trigger: panel,
        start: 'top center',
        end: 'bottom center',
        onEnter: () => setActiveIndex(i),
        onEnterBack: () => setActiveIndex(i),
      });

      // Individual panel fade in
      gsap.to(panel, {
        scrollTrigger: {
          trigger: panel,
          start: 'top 85%',
          toggleActions: 'play none none reverse'
        },
        opacity: 1, 
        y: 0, 
        duration: 0.8, 
        ease: 'power2.out'
      });
    });

    function setActiveIndex(index: number) {
      navBtns.forEach(btn => btn.classList.remove('active'));
      if (navBtns[index]) {
        navBtns[index].classList.add('active');
      }
      
      // Update progress bar
      if (progressBar) {
        gsap.to(progressBar, {
          y: `${index * 100}%`,
          duration: 0.4,
          ease: 'power2.out'
        });
      }
    }

    // Click navigation
    navBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        
        // Lenis will handle the smooth scroll through the layout script,
        // but since we need an exact offset for the sticky area:
        const target = document.querySelector(targetId);
        if (target) {
          // Calculate offset roughly based on viewport
          const offset = window.innerHeight * 0.2; 
          window.scrollTo({
            top: target.getBoundingClientRect().top + window.scrollY - offset,
            behavior: 'smooth'
          });
        }
      });
    });
  });
</script>
