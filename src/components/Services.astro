---
import type { Dictionary } from "../i18n";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const highlightWord = (value: string, words: string[]) => {
  const title = value.trim();
  const word = words.find((candidate) => title.toLowerCase().includes(candidate.toLowerCase()));
  if (!word) return { before: title, accent: "", after: "" };
  const index = title.toLowerCase().indexOf(word.toLowerCase());
  return {
    before: title.slice(0, index).trimEnd(),
    accent: title.slice(index, index + word.length),
    after: title.slice(index + word.length).trimStart(),
  };
};
const servicesHeading = highlightWord(t.services.title, ["Power", "poder"]);
const services = t.services.items.map((service, index) => ({
  ...service,
  id: ["services-video", "services-landing", "services-web"][index],
  visual: "bg-black",
}));
---

<section id="services" class="relative bg-white py-24 lg:py-40">
  <div class="absolute top-0 left-6 right-6 lg:left-8 lg:right-8 h-px bg-[var(--color-border)]"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 mb-16 lg:mb-32">
    <div class="services-title opacity-0 translate-y-12">
      <SectionHeading before={servicesHeading.before} accent={servicesHeading.accent} after={servicesHeading.after} class="max-w-3xl" />
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-24 relative items-start">
      <div class="lg:sticky lg:top-40 hidden lg:block z-20">
        <ul class="flex flex-col gap-8 relative">
          <div class="absolute left-0 top-2 bottom-2 w-px bg-[var(--color-border-light)] z-[-1]"></div>
          <div class="absolute left-0 top-2 h-1/3 w-px bg-[var(--color-accent)] z-0 transition-all duration-300 services-progress"></div>

          {services.map((service, index) => (
            <li class="pl-8">
              <button class="service-nav-btn text-left group w-full" data-index={index} data-target={`#${service.id}`}>
                <h3 class="font-display font-bold text-3xl lg:text-4xl transition-colors duration-300 text-[var(--color-text-muted)] group-[.active]:text-[var(--color-accent)]">
                  {service.title}
                </h3>
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="flex flex-col gap-24 lg:gap-[50vh] services-content-wrap pb-[20vh]">
        {services.map((service, index) => (
          <div id={service.id} class="service-panel opacity-0 translate-y-24 transition-all duration-700 w-full" data-index={index}>
            <h3 class="lg:hidden font-display font-bold text-3xl mb-6 text-[var(--color-text)]">{service.title}</h3>
            <div class={`w-full aspect-square md:aspect-[4/3] rounded-2xl ${service.visual} border border-[var(--color-border)] shadow-xl shadow-black/5 mb-8 flex items-center justify-center overflow-hidden relative group`}></div>
            <p class="text-lg lg:text-xl text-[var(--color-text-secondary)] font-medium leading-relaxed">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  requestAnimationFrame(() => {
    gsap.to('.services-title', { scrollTrigger: { trigger: '#services', start: 'top 75%', once: true }, opacity: 1, y: 0, duration: 1, ease: 'power3.out' });

    const panels = gsap.utils.toArray('.service-panel') as HTMLElement[];
    const navBtns = gsap.utils.toArray('.service-nav-btn') as HTMLElement[];
    const progressBar = document.querySelector('.services-progress') as HTMLElement;

    if (panels.length === 0) return;

    navBtns[0]?.classList.add('active');
    panels[0].classList.remove('opacity-0', 'translate-y-24');

    panels.forEach((panel, i) => {
      ScrollTrigger.create({ trigger: panel, start: 'top center', end: 'bottom center', onEnter: () => setActiveIndex(i), onEnterBack: () => setActiveIndex(i) });
      gsap.to(panel, { scrollTrigger: { trigger: panel, start: 'top 85%', toggleActions: 'play none none reverse' }, opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' });
    });

    function setActiveIndex(index: number) {
      navBtns.forEach(btn => btn.classList.remove('active'));
      navBtns[index]?.classList.add('active');
      if (progressBar) gsap.to(progressBar, { y: `${index * 100}%`, duration: 0.4, ease: 'power2.out' });
    }

    navBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const target = document.querySelector(targetId);
        if (target) {
          const offset = window.innerHeight * 0.2;
          window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - offset, behavior: 'smooth' });
        }
      });
    });
  });
</script>

