---
type ButtonVariant = "dark" | "light" | "white";
type ButtonSize = "sm" | "md" | "lg" | "icon";
interface Props {
  href?: string;
  target?: "_blank" | "_self" | "_parent" | "_top";
  rel?: string;
  type?: "button" | "submit" | "reset";
  variant?: ButtonVariant;
  asSpan?: boolean;
  size?: ButtonSize;
  contactModal?: boolean;
  videoModalSrc?: string;
  videoModalTitle?: string;
  videoModalClose?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  target,
  rel,
  type = "button",
  variant = "dark",
  asSpan = false,
  size = "md",
  contactModal = false,
  videoModalSrc,
  videoModalTitle,
  videoModalClose = false,
  class: className = "",
  ariaLabel,
} = Astro.props;

const baseClass =
  "group relative isolate inline-flex cursor-pointer items-center justify-center overflow-hidden rounded-full border-2 font-bold transition-colors duration-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-2";
const sizeClasses: Record<ButtonSize, string> = {
  sm: "h-11 px-6 text-sm",
  md: "px-8 py-4 text-base",
  lg: "px-10 py-5 text-xl",
  icon: "size-11 p-0 text-sm",
};
const variantClasses: Record<ButtonVariant, string> = {
  dark: "border-[var(--color-text)] bg-transparent text-[var(--color-text)] hover:border-transparent hover:text-white",
  light: "border-white bg-transparent text-white hover:border-transparent hover:text-white focus-visible:ring-offset-black",
  white: "border-white bg-white text-black hover:border-transparent hover:text-white focus-visible:ring-offset-black",
};
const buttonClass = [baseClass, sizeClasses[size], variantClasses[variant], className].filter(Boolean).join(" ");
const fillClass =
  "absolute inset-0 z-0 h-full w-full -translate-y-full rounded-full bg-[var(--color-accent)] transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:translate-y-0 group-focus-visible:translate-y-0";
---

{asSpan ? (
  <span class={buttonClass} aria-label={ariaLabel}>
    <span class={fillClass}></span>
    <span class="relative z-10"><slot /></span>
  </span>
) : href ? (
  <a
    href={href}
    target={target}
    rel={rel ?? (target === "_blank" ? "noopener noreferrer" : undefined)}
    class={buttonClass}
    data-contact-modal-open={contactModal ? "" : undefined}
    data-video-modal-open={videoModalSrc ? "" : undefined}
    data-video-src={videoModalSrc}
    data-video-title={videoModalTitle}
    data-video-modal-close={videoModalClose ? "" : undefined}
    aria-label={ariaLabel}
  >
    <span class={fillClass}></span>
    <span class="relative z-10"><slot /></span>
  </a>
) : (
  <button
    type={type}
    class={buttonClass}
    data-contact-modal-open={contactModal ? "" : undefined}
    data-video-modal-open={videoModalSrc ? "" : undefined}
    data-video-src={videoModalSrc}
    data-video-title={videoModalTitle}
    data-video-modal-close={videoModalClose ? "" : undefined}
    aria-label={ariaLabel}
  >
    <span class={fillClass}></span>
    <span class="relative z-10"><slot /></span>
  </button>
)}