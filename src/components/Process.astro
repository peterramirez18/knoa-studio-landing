---
import type { Dictionary } from "../i18n";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const steps = t.process.steps.map((step, index) => ({
  ...step,
  phase: String(index + 1).padStart(2, "0"),
}));
const titleLines = t.process.title.split("\n");
---

<section id="process" class="relative bg-[var(--color-text)] text-white py-24 lg:py-40 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 mb-20">
    <h2 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl tracking-tight mb-6 process-title opacity-0 translate-y-12">
      {titleLines.map((line, index) => (
        <>{line}{index < titleLines.length - 1 && <br />}</>
      ))}
    </h2>

    <p class="text-lg lg:text-xl text-[var(--color-text-muted)] max-w-2xl process-title opacity-0 translate-y-8">
      {t.process.intro}
    </p>
  </div>

  <div class="process-scroll-container w-full h-[600px] relative">
    <div class="sticky top-1/4 w-full overflow-hidden process-track-viewport">
      <div class="process-track flex items-start gap-8 lg:gap-16 px-6 lg:px-8 w-[250vw] md:w-[150vw] lg:w-[120vw]">
        {steps.map((step) => (
          <div class="process-step-card flex-shrink-0 w-[85vw] md:w-[40vw] lg:w-[30vw] border-t-2 border-[var(--color-text-secondary)] pt-8 relative group opacity-40">
            <div class="absolute top-[-2px] left-0 h-[2px] bg-white w-0 group-[.is-active]:w-full transition-all duration-700 ease-out process-progress-line"></div>
            <div class="mb-8">
              <span class="text-sm font-mono text-[var(--color-text-muted)] mb-4 block">{t.process.phase} {step.phase}</span>
              <h3 class="font-display font-bold text-2xl lg:text-3xl text-white group-[.is-active]:text-[var(--color-accent-light)] transition-colors duration-500">
                {step.title}
              </h3>
            </div>
            <ul class="space-y-4">
              {step.items.map((item) => (
                <li class="flex items-start gap-3 text-[var(--color-text-muted)] group-[.is-active]:text-gray-200 transition-colors duration-500">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[var(--color-text-secondary)] group-[.is-active]:bg-[var(--color-accent)] transition-colors duration-500 flex-shrink-0"></span>
                  <span class="text-base lg:text-lg leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  requestAnimationFrame(() => {
    gsap.to('.process-title', { scrollTrigger: { trigger: '#process', start: 'top 75%', once: true }, opacity: 1, y: 0, duration: 1, stagger: 0.1, ease: 'power3.out' });

    const container = document.querySelector('.process-scroll-container') as HTMLElement;
    const track = document.querySelector('.process-track') as HTMLElement;
    const cards = gsap.utils.toArray('.process-step-card') as HTMLElement[];

    if (!container || !track || cards.length === 0) return;

    const scrollDist = track.scrollWidth - window.innerWidth;

    gsap.to(track, {
      x: -scrollDist,
      ease: 'none',
      scrollTrigger: {
        trigger: container,
        pin: true,
        scrub: 0.5,
        start: 'center center',
        end: `+=${scrollDist}`,
        onUpdate: (self) => {
          let activeIndex = Math.floor(self.progress * cards.length);
          if (activeIndex >= cards.length) activeIndex = cards.length - 1;

          cards.forEach((card, idx) => {
             if(idx === activeIndex) {
               card.classList.add('is-active', 'opacity-100');
               card.classList.remove('opacity-40');
             } else {
               card.classList.remove('is-active', 'opacity-100');
               card.classList.add('opacity-40');
             }
          });
        }
      }
    });

    if(cards[0]) {
       cards[0].classList.add('is-active', 'opacity-100');
       cards[0].classList.remove('opacity-40');
    }
  });
</script>
