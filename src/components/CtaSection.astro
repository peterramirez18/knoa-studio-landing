---
import type { Dictionary } from "../i18n";
import Button from "./Button.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const highlightWord = (value: string, words: string[]) => {
  const title = value.trim();
  const word = words.find((candidate) => title.toLowerCase().includes(candidate.toLowerCase()));
  if (!word) return { before: title, accent: "", after: "" };
  const index = title.toLowerCase().indexOf(word.toLowerCase());
  return {
    before: title.slice(0, index).trimEnd(),
    accent: title.slice(index, index + word.length),
    after: title.slice(index + word.length).trimStart(),
  };
};
const ctaHeading = highlightWord(t.cta.title, ["Ready", "Listo"]);
---

<section id="cta" class="relative py-32 lg:py-56 overflow-hidden bg-[var(--color-bg)]">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 text-center flex flex-col items-center">
    <div class="w-4 h-4 rounded-full bg-[var(--color-accent)] mb-8 cta-element opacity-0 scale-50"></div>

    <div class="mb-12 max-w-4xl cta-element opacity-0 translate-y-16">
      <SectionHeading before={ctaHeading.before} accent={ctaHeading.accent} after={ctaHeading.after} />
    </div>

    <div class="cta-element opacity-0 translate-y-8">
      <Button href="#contact" contactModal size="lg">
        {t.cta.button}
      </Button>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  requestAnimationFrame(() => {
    gsap.to(".cta-element", { scrollTrigger: { trigger: "#cta", start: "top 60%", once: true }, opacity: 1, y: 0, scale: 1, duration: 1.2, stagger: 0.15, ease: "power4.out" });
  });
</script>
