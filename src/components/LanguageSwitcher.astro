---
import type { Dictionary, Locale } from "../i18n";

interface Props {
  locale: Locale;
  t: Dictionary;
}

const { locale, t } = Astro.props;
const linkClass = "opacity-[.55] transition-opacity duration-200 hover:opacity-100 focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] focus-visible:outline-offset-3 focus-visible:rounded-sm aria-[current=page]:opacity-100";
---

<nav class="fixed right-6 top-5 z-[60] flex items-center gap-2 rounded-full border border-white/20 bg-[#111]/70 px-3 py-2 text-[0.72rem] font-bold tracking-[0.08em] text-white backdrop-blur-[14px]" aria-label={t.language.label}>
  <a href="/" lang="en" aria-current={locale === "en" ? "page" : undefined} class={linkClass}>{t.language.english}</a>
  <span aria-hidden="true">/</span>
  <a href="/es/" lang="es" aria-current={locale === "es" ? "page" : undefined} class={linkClass}>{t.language.spanish}</a>
</nav>
