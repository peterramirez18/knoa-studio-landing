---
const caseStudies = [
  {
    title: 'Meridian Finance',
    category: 'Motion Design',
    sub: 'Launch Strategy',
    visual: 'bg-black',
    link: '#meridian'
  },
  {
    title: 'Aura Health',
    category: 'Landing Page',
    sub: 'Web Development',
    visual: 'bg-black',
    link: '#aura'
  },
  {
    title: 'Pulse AI',
    category: 'Brand System',
    sub: 'Motion Graphics',
    visual: 'bg-black',
    link: '#pulse'
  },
  {
    title: 'Forma Studio',
    category: 'Web Experience',
    sub: '3D Look Dev',
    visual: 'bg-black',
    link: '#forma'
  }
];
---

<section id="case-studies" class="relative py-24 lg:py-40 bg-[var(--color-bg-subtle)]">
  
  <div class=" px-6 lg:px-8">
    
    <!-- Header -->
    <div class="mb-16 lg:mb-24 flex flex-col md:flex-row md:items-end justify-between gap-6 cs-header opacity-0 translate-y-12 max-w-7xl mx-auto">
      <div class="max-w-xl">
        <h2 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl tracking-tight text-[var(--color-text)] mb-4">
          Highlighted Work
        </h2>
        <h3 class="font-sans text-xl sm:text-2xl text-[var(--color-text-secondary)] font-medium">
          A selection of our recent projects.
        </h3>
      </div>
      <!-- <div>
        <a href="#work" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-[var(--color-border)] bg-white text-sm font-semibold hover:border-[var(--color-text)] transition-colors duration-300">
          Discover More
        </a>
      </div> -->
    </div>

    <!-- 2x2 Grid -->
    <div class="grid md:grid-cols-3 gap-6 lg:gap-10">
      {caseStudies.map((study, idx) => (
        <a href={study.link} class={`group cs-card opacity-0 translate-y-20 block ${idx === 0 || idx === 3 ? 'md:col-span-2' : ''}`}>
          
          <!-- Visual Container -->
          <div class={`w-full rounded-2xl ${study.visual} overflow-hidden relative mb-6 isolate flex items-center justify-center ${idx === 0 || idx === 3 ? 'aspect-[4/3]' : 'aspect-[3/4]'}`}>
            
            <!-- Video Placeholder overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent z-10"></div>
            
            <!-- Abstract shapes -->
            <div class="w-1/2 aspect-square rounded-full border border-white/10 group-hover:scale-150 transition-transform duration-1000 ease-[cubic-bezier(0.25,1,0.5,1)]"></div>
            
            <!-- Hover 'View Post' cursor circle (simulated) -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-20 h-20 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center opacity-0 scale-50 group-hover:opacity-100 group-hover:scale-100 transition-all duration-500 z-20 pointer-events-none">
              <span class="text-white text-xs font-bold tracking-wider uppercase">View</span>
            </div>
          </div>

          <!-- Metadata -->
          <div class="px-2">
            <h3 class="font-display font-bold text-2xl lg:text-3xl text-[var(--color-text)] mb-2 group-hover:text-[var(--color-accent)] transition-colors duration-300">
              {study.title}
            </h3>
            <div class="flex items-center gap-3 text-sm font-medium text-[var(--color-text-secondary)]">
              <span>{study.category}</span>
              <span class="w-1 h-1 rounded-full bg-[var(--color-border)]"></span>
              <span>{study.sub}</span>
            </div>
          </div>

        </a>
      ))}
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  requestAnimationFrame(() => {
    gsap.to('.cs-header', {
      scrollTrigger: { trigger: '#case-studies', start: 'top 75%', once: true },
      opacity: 1, y: 0, duration: 1, ease: 'power3.out'
    });

    gsap.to('.cs-card', {
      scrollTrigger: { trigger: '.cs-card', start: 'top 85%', once: true },
      opacity: 1, y: 0, duration: 1, stagger: 0.15, ease: 'power3.out'
    });
  });
</script>
