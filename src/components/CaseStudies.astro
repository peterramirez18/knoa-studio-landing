---
import type { Dictionary } from "../i18n";
import { Image } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import minqikImage from "../assets/projects/minqik.png";
import parqueameImage from "../assets/projects/parqueameapp.png";
import bciImage from "../assets/projects/bci.png";
import reinasVideo from "../assets/projects/REINAS.mp4";
import ldaVideo from "../assets/projects/BUMPER LDF 1.mp4";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const projectNumbers = {
  minqik: "01",
  papp: "02",
  reinas: "03",
  coopcibao: "04",
  lda: "05",
  bci: "06",
};
const projects = t.work.projects;
const splitLastWord = (value: string) => {
  const words = value.trim().split(/\s+/);
  return {
    before: words.slice(0, -1).join(" "),
    accent: words.at(-1) ?? "",
  };
};
const workHeading = splitLastWord(t.work.title);
const billing = t.work.billing;
const coopcibaoVideo = "/video-placeholder.mp4";
const projectNumberClass =
  "font-display text-[clamp(4.5rem,7vw,7rem)] leading-[0.8] tracking-[-0.06em] text-[var(--color-accent)] font-light mb-9 max-[900px]:mb-6";
const projectTitleClass =
  "font-display text-[clamp(2.2rem,4vw,4rem)] leading-[0.95] tracking-[-0.04em] font-semibold mb-4";
const projectTypeClass = "text-[#555] text-base leading-[1.3]";
const projectDescriptionClass =
  "max-w-[28rem] text-[#666] leading-[1.55] mt-auto pt-8 max-[900px]:mt-0";
const projectCopyClass =
  "px-1 pt-6 pb-6 flex flex-col items-start max-[900px]:px-2 max-[900px]:py-10";
const visualClass =
  "min-h-[31rem] relative overflow-hidden rounded-lg max-[600px]:min-h-96";
const imageClass =
  "h-full w-full object-cover rounded-md shadow-[0_1.5rem_4rem_rgba(28,50,80,0.16)]";
const videoClass =
  "h-full w-full object-cover rounded-md shadow-[0_1.5rem_4rem_rgba(28,50,80,0.16)]";
const viewProjectLabel = t.nav.cta === "Hablemos" ? "Ver proyecto" : "View project";
const viewVideoLabel = t.nav.cta === "Hablemos" ? "Ver video" : "Watch video";
const actionOverlayClass =
  "pointer-events-none absolute inset-0 flex items-end justify-end bg-black/0 p-5 opacity-0 transition-all duration-300 group-hover:bg-black/25 group-hover:opacity-100 group-focus-visible:bg-black/25 group-focus-visible:opacity-100";
const actionButtonClass =
  "relative isolate inline-flex h-11 items-center justify-center overflow-hidden rounded-full border-2 border-white bg-white px-6 text-sm font-bold text-black shadow-lg transition-colors duration-500 group-hover:border-transparent group-hover:text-white group-focus-visible:border-transparent group-focus-visible:text-white";
const actionButtonFillClass =
  "absolute inset-0 z-0 h-full w-full -translate-y-full rounded-full bg-[var(--color-accent)] transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:translate-y-0 group-focus-visible:translate-y-0";
const oneVisual = t.nav.cta === "Hablemos"
  ? { operations: "Operaciones", invoices: "Facturas", clients: "Clientes", revenue: "Ingresos", status: "Todo al dia", panel: "Panel central", activity: "Actividad", pipeline: "Flujo" }
  : { operations: "Operations", invoices: "Invoices", clients: "Clients", revenue: "Revenue", status: "All caught up", panel: "Command center", activity: "Activity", pipeline: "Pipeline" };
---

<section
  id="case-studies"
  class="bg-[#f5f5f3] px-6 pt-28 pb-36 overflow-hidden max-[600px]:px-4 max-[600px]:pt-20 max-[600px]:pb-24"
>
  <div class="max-w-7xl mx-auto">
    <header
      class="cs-reveal grid grid-cols-[minmax(0,1fr)_5rem_minmax(15rem,22rem)] items-center gap-8 mb-24 max-[900px]:grid-cols-1 max-[900px]:gap-6 max-[600px]:mb-16"
    >
      <SectionHeading before={workHeading.before} accent={workHeading.accent} />
      <span class="h-px bg-[#a9a9a5] max-[900px]:w-20" aria-hidden="true"
      ></span>
      <p class="text-[1.05rem] leading-[1.35] max-w-[22rem]">
        {t.work.subtitle}
      </p>
    </header>

    <div>
      <article
        id="project-minqik"
        class="cs-reveal scroll-mt-28 grid grid-cols-[minmax(15rem,0.62fr)_minmax(0,1.8fr)] gap-[clamp(2rem,5vw,6rem)] py-5 items-stretch max-[900px]:grid-cols-1"
      >
        <div class={projectCopyClass}>
          <span class={projectNumberClass}>{projectNumbers.minqik}</span>
          <h3 class={projectTitleClass}>{projects.minqik.title}</h3>
          <p class={projectTypeClass}>
            {projects.minqik.category}<br />{projects.minqik.discipline}
          </p>
          <p class={projectDescriptionClass}>{projects.minqik.description}</p>
        </div>
        <a
          href="https://www.minqik.com"
          target="_blank"
          rel="noopener noreferrer"
          class={`${visualClass} group cursor-pointer bg-[#dcd6ff] flex items-center justify-center max-[600px]:p-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-4`}
          aria-label={`${viewProjectLabel}: ${projects.minqik.title}`}
        >
          <Image
            src={minqikImage}
            alt={projects.minqik.title}
            loading="lazy"
            decoding="async"
            class={imageClass}
          />
          <span class={actionOverlayClass}>
            <span class={actionButtonClass}>
              <span class={actionButtonFillClass}></span>
              <span class="relative z-10">{viewProjectLabel}</span>
            </span>
          </span>
        </a>
      </article>

      <article
        id="project-papp"
        class="cs-reveal scroll-mt-28 grid grid-cols-[minmax(0,1.8fr)_minmax(15rem,0.62fr)] gap-[clamp(2rem,5vw,6rem)] py-5 items-stretch max-[900px]:grid-cols-1"
      >
        <a
          href="https://www.parqueameapp.com"
          target="_blank"
          rel="noopener noreferrer"
          class={`${visualClass} group cursor-pointer bg-[#eeeee9] flex items-center justify-center max-[900px]:order-2 max-[600px]:p-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-4`}
          aria-label={`${viewProjectLabel}: ${projects.papp.title}`}
        >
          <Image
            src={parqueameImage}
            alt={projects.papp.title}
            loading="lazy"
            decoding="async"
            class={imageClass}
          />
          <span class={actionOverlayClass}>
            <span class={actionButtonClass}>
              <span class={actionButtonFillClass}></span>
              <span class="relative z-10">{viewProjectLabel}</span>
            </span>
          </span>
        </a>
        <div class={`${projectCopyClass} max-[900px]:order-1`}>
          <span class={projectNumberClass}>{projectNumbers.papp}</span>
          <h3 class={projectTitleClass}>{projects.papp.title}</h3>
          <p class={projectTypeClass}>
            {projects.papp.category}<br />{projects.papp.discipline}
          </p>
          <p class={projectDescriptionClass}>{projects.papp.description}</p>
        </div>
      </article>

      <article
        id="project-reinas"
        class="cs-reveal my-5 scroll-mt-28 min-h-[31rem] grid grid-cols-[minmax(16rem,0.62fr)_1.5fr] bg-[#101010] text-white rounded-lg overflow-hidden max-[900px]:grid-cols-1 max-[600px]:-mx-4 max-[600px]:rounded-none"
      >
        <div
          class="p-12 flex flex-col items-start max-[600px]:px-6 max-[600px]:py-10"
        >
          <span class={projectNumberClass}>{projectNumbers.reinas}</span>
          <h3 class={projectTitleClass}>{projects.reinas.title}</h3>
          <p class="text-[#aaa] text-base leading-[1.3]">
            {projects.reinas.category}<br />{projects.reinas.discipline}
          </p>
          <p class="max-w-[28rem] text-[#aaa] leading-[1.55] mt-auto pt-8">
            {projects.reinas.description}
          </p>
        </div>
        <button
          type="button"
          class="group relative h-full w-full cursor-pointer overflow-hidden text-left max-[900px]:min-h-[25rem] max-[900px]:border-[#444] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-inset"
          data-video-modal-open
          data-video-src={reinasVideo}
          data-video-title={projects.reinas.title}
          aria-label={`${viewVideoLabel}: ${projects.reinas.title}`}
        >
          <video
            data-lazy-src={reinasVideo}
            class="h-full w-full object-cover"
            loop
            muted
            playsinline
            preload="none"></video>
          <span class={actionOverlayClass}>
            <span class={actionButtonClass}>
              <span class={actionButtonFillClass}></span>
              <span class="relative z-10">{viewVideoLabel}</span>
            </span>
          </span>
        </button>
      </article>

      <div class="grid grid-cols-2 max-[900px]:grid-cols-1 gap-10">
        <article
          id="project-coopcibao"
          class="cs-reveal scroll-mt-28 pb-12 max-[900px]:border-r-0 max-[900px]:border-b max-[900px]:border-[#dcdcd7] max-[600px]:px-0"
        >
          <div class="flex flex-col items-start">
            <span
              class="font-display text-[clamp(4.5rem,7vw,7rem)] leading-[0.8] tracking-[-0.06em] text-[var(--color-accent)] font-light mb-6"
              >{projectNumbers.coopcibao}</span
            >
            <h3
              class="font-display text-[clamp(2.2rem,3.5vw,3.6rem)] leading-[0.95] tracking-[-0.04em] font-semibold mb-4"
            >
              {projects.coopcibao.title}
            </h3>
            <p class={projectTypeClass}>
              {projects.coopcibao.category} / {projects.coopcibao.discipline}
            </p>
          </div>
          <button
            type="button"
            class="group h-80 my-8 relative w-full cursor-pointer overflow-hidden rounded-md bg-[#101010] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-4"
            data-video-modal-open
            data-video-src={coopcibaoVideo}
            data-video-title={projects.coopcibao.title}
            aria-label={`${viewVideoLabel}: ${projects.coopcibao.title}`}
          >
            <video
              data-lazy-src={coopcibaoVideo}
              class={videoClass}
              loop
              muted
              playsinline
              preload="none"></video>
            <span class={actionOverlayClass}>
              <span class={actionButtonClass}>
                <span class={actionButtonFillClass}></span>
                <span class="relative z-10">{viewVideoLabel}</span>
              </span>
            </span>
          </button>
          <p class="max-w-[28rem] text-[#666] leading-[1.55]">
            {projects.coopcibao.description}
          </p>
        </article>

        <article id="project-lda" class="cs-reveal scroll-mt-28 pb-12 max-[600px]:px-0">
          <div class="flex flex-col items-start">
            <span
              class="font-display text-[clamp(4.5rem,7vw,7rem)] leading-[0.8] tracking-[-0.06em] text-[var(--color-accent)] font-light mb-6"
              >{projectNumbers.lda}</span
            >
            <h3
              class="font-display text-[clamp(2.2rem,3.5vw,3.6rem)] leading-[0.95] tracking-[-0.04em] font-semibold mb-4"
            >
              {projects.lda.title}
            </h3>
            <p class={projectTypeClass}>
              {projects.lda.category} / {projects.lda.discipline}
            </p>
          </div>
          <button
            type="button"
            class="group h-80 my-8 relative w-full cursor-pointer overflow-hidden rounded-md bg-[#101010] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-4"
            data-video-modal-open
            data-video-src={ldaVideo}
            data-video-title={projects.lda.title}
            aria-label={`${viewVideoLabel}: ${projects.lda.title}`}
          >
            <video
              data-lazy-src={ldaVideo}
              class={videoClass}
              loop
              muted
              playsinline
              preload="none"></video>
            <span class={actionOverlayClass}>
              <span class={actionButtonClass}>
                <span class={actionButtonFillClass}></span>
                <span class="relative z-10">{viewVideoLabel}</span>
              </span>
            </span>
          </button>
          <p class="max-w-[28rem] text-[#666] leading-[1.55]">
            {projects.lda.description}
          </p>
        </article>
      </div>

      <article
        id="project-bci"
        class="cs-reveal scroll-mt-28 grid grid-cols-[minmax(0,1.8fr)_minmax(15rem,0.62fr)] gap-[clamp(2rem,5vw,6rem)] py-5 items-stretch max-[900px]:grid-cols-1"
      >
        <a
          href="https://bci.com.do"
          target="_blank"
          rel="noopener noreferrer"
          class={`${visualClass} group cursor-pointer bg-white flex items-center justify-center max-[900px]:order-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-4`}
          aria-label={`${viewProjectLabel}: ${projects.bci.title}`}
        >
          <Image
            src={bciImage}
            alt={projects.bci.title}
            loading="lazy"
            decoding="async"
            class={imageClass}
          />
          <span class={actionOverlayClass}>
            <span class={actionButtonClass}>
              <span class={actionButtonFillClass}></span>
              <span class="relative z-10">{viewProjectLabel}</span>
            </span>
          </span>
        </a>
        <div class={`${projectCopyClass} max-[900px]:order-1`}>
          <span class={projectNumberClass}>{projectNumbers.bci}</span>
          <h3 class={projectTitleClass}>{projects.bci.title}</h3>
          <p class={projectTypeClass}>
            {projects.bci.category}<br />{projects.bci.discipline}
          </p>
          <p class={projectDescriptionClass}>{projects.bci.description}</p>
        </div>
      </article>
    </div>

    <article
      id="project-knoa-one"
      class="cs-reveal scroll-mt-28 mt-24 min-h-[34rem] grid grid-cols-[0.72fr_1.45fr] overflow-hidden rounded-[0.6rem] bg-[#101010] text-white max-[900px]:grid-cols-1 max-[600px]:-mx-4 max-[600px]:rounded-none"
    >
      <div
        class="p-16 flex flex-col items-start max-[600px]:px-6 max-[600px]:py-12"
      >
        <span class="mb-10 text-[0.65rem] font-bold uppercase tracking-[0.15em]"
          ><i
            class="mr-2 inline-block size-2 rounded-full bg-[var(--color-accent)]"
          ></i>
          {billing.label}</span
        >
        <h3
          class="font-display text-[clamp(3.3rem,5vw,5.5rem)] leading-[0.9] tracking-[-0.055em] mb-5"
        >
          {billing.title}
        </h3>
        <p class="text-[var(--color-accent)] font-semibold mb-8">
          {billing.type}
        </p>
        <p
          class="text-[#aaa] leading-[1.55] max-w-[22rem] mt-auto max-[900px]:mt-4"
        >
          {billing.description}
        </p>
      </div>
      <a
        href="https://one.knoastudio.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative mt-10 flex cursor-pointer items-center overflow-hidden rounded-tl-2xl bg-[#181818] p-6 max-[900px]:mx-6 max-[900px]:mt-0 max-[900px]:min-h-[25rem] max-[900px]:rounded-t-2xl max-[600px]:mx-3 max-[600px]:p-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-4 focus-visible:ring-offset-black"
        aria-label={`${viewProjectLabel}: ${billing.title}`}
      >
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(248,84,59,0.26),transparent_34%),radial-gradient(circle_at_80%_10%,rgba(255,255,255,0.12),transparent_28%)]"></div>
        <div class="relative w-full overflow-hidden rounded-2xl border border-white/10 bg-[#0f1117] shadow-[0_1.5rem_4rem_rgba(0,0,0,0.45)]">
          <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
            <div class="flex items-center gap-3">
              <span class="grid size-9 place-items-center rounded-xl bg-[var(--color-accent)] text-sm font-black text-white">1</span>
              <div>
                <p class="text-sm font-bold leading-none text-white">Knoa One</p>
                <p class="mt-1 text-[0.68rem] font-bold uppercase tracking-[0.16em] text-white/35">{oneVisual.panel}</p>
              </div>
            </div>
            <span class="rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-[0.68rem] font-bold uppercase tracking-[0.12em] text-emerald-200">{oneVisual.status}</span>
          </div>

          <div class="grid gap-4 p-5 lg:grid-cols-[0.85fr_1.15fr]">
            <div class="grid gap-3">
              {[oneVisual.operations, oneVisual.invoices, oneVisual.clients].map((item, index) => (
                <div class:list={["rounded-xl border border-white/8 p-4", index === 0 ? "bg-white text-black" : "bg-white/6 text-white"]}>
                  <p class:list={["text-[0.68rem] font-bold uppercase tracking-[0.14em]", index === 0 ? "text-black/45" : "text-white/35"]}>{item}</p>
                  <div class="mt-3 h-2 overflow-hidden rounded-full bg-black/10">
                    <span class:list={["block h-full rounded-full", index === 0 ? "w-[82%] bg-[var(--color-accent)]" : index === 1 ? "w-[64%] bg-white/55" : "w-[72%] bg-white/55"]}></span>
                  </div>
                </div>
              ))}
            </div>

            <div class="grid gap-4">
              <div class="rounded-2xl border border-white/8 bg-white p-5 text-black">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="text-xs font-bold uppercase tracking-[0.14em] text-black/40">{oneVisual.revenue}</p>
                    <p class="mt-2 text-3xl font-black tracking-[-0.04em]">RD$ 1.2M</p>
                  </div>
                  <span class="rounded-full bg-[var(--color-accent)] px-3 py-1 text-xs font-black text-white">+18%</span>
                </div>
                <div class="mt-5 flex h-28 items-end gap-2">
                  {[42, 58, 48, 76, 64, 92, 72, 84].map((height) => (
                    <span class="flex-1 rounded-t-md bg-[linear-gradient(180deg,var(--color-accent),#ff9a4b)]" style={`height:${height}%`}></span>
                  ))}
                </div>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div class="rounded-xl border border-white/8 bg-white/6 p-4 text-white">
                  <p class="text-[0.68rem] font-bold uppercase tracking-[0.14em] text-white/35">{oneVisual.activity}</p>
                  <p class="mt-2 text-xl font-black">248</p>
                </div>
                <div class="rounded-xl border border-white/8 bg-white/6 p-4 text-white">
                  <p class="text-[0.68rem] font-bold uppercase tracking-[0.14em] text-white/35">{oneVisual.pipeline}</p>
                  <p class="mt-2 text-xl font-black">94%</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <span class={actionOverlayClass}>
          <span class={actionButtonClass}>
            <span class={actionButtonFillClass}></span>
            <span class="relative z-10">{viewProjectLabel}</span>
          </span>
        </span>
      </a>
    </article>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  requestAnimationFrame(() => {
    gsap.utils.toArray<HTMLElement>(".cs-reveal").forEach((element) => {
      gsap.to(element, {
        scrollTrigger: { trigger: element, start: "top 88%", once: true },
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: "power3.out",
      });
    });
  });

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const lazyVideos = document.querySelectorAll<HTMLVideoElement>("video[data-lazy-src]");
  const videoObserver = new IntersectionObserver(
    (entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const video = entry.target as HTMLVideoElement;
        const src = video.dataset.lazySrc;
        if (src) {
          video.src = src;
          video.load();
          if (!reducedMotion) video.play().catch(() => undefined);
        }
        observer.unobserve(video);
      });
    },
    { rootMargin: "300px" },
  );
  lazyVideos.forEach((video) => videoObserver.observe(video));
</script>
