---
import type { Dictionary } from "../i18n";
import minqikImage from "../assets/projects/minqik.png";
import parqueameImage from "../assets/projects/parqueameapp.png";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const projectNumbers = {
  minqik: "01",
  papp: "02",
  coopcibao: "03",
  kulkul: "04",
  lda: "05",
  bci: "06",
};
const projects = t.work.projects;
const billing = t.work.billing;
const projectNumberClass =
  "font-display text-[clamp(4.5rem,7vw,7rem)] leading-[0.8] tracking-[-0.06em] text-[var(--color-accent)] font-light mb-9 max-[900px]:mb-6";
const projectTitleClass =
  "font-display text-[clamp(2.2rem,4vw,4rem)] leading-[0.95] tracking-[-0.04em] font-semibold mb-4";
const projectTypeClass = "text-[#555] text-base leading-[1.3]";
const projectDescriptionClass =
  "max-w-[28rem] text-[#666] leading-[1.55] mt-auto pt-8 max-[900px]:mt-0";
const projectCopyClass =
  "px-1 pt-6 pb-6 flex flex-col items-start max-[900px]:px-2 max-[900px]:py-10";
const visualClass =
  "min-h-[31rem] relative overflow-hidden rounded-lg max-[600px]:min-h-96";
const imageClass =
  "h-full w-full object-cover rounded-md shadow-[0_1.5rem_4rem_rgba(28,50,80,0.16)]";
---

<section
  id="case-studies"
  class="bg-[#f5f5f3] px-6 pt-28 pb-36 overflow-hidden max-[600px]:px-4 max-[600px]:pt-20 max-[600px]:pb-24"
>
  <div class="max-w-7xl mx-auto">
    <header
      class="cs-reveal grid grid-cols-[minmax(0,1fr)_5rem_minmax(15rem,22rem)] items-center gap-8 mb-24 max-[900px]:grid-cols-1 max-[900px]:gap-6 max-[600px]:mb-16"
    >
      <h2
        class="font-display text-[clamp(4rem,8vw,7.5rem)] leading-[0.86] tracking-[-0.065em] font-bold max-[600px]:text-[3.8rem]"
      >
        {t.work.title}
      </h2>
      <span class="h-px bg-[#a9a9a5] max-[900px]:w-20" aria-hidden="true"
      ></span>
      <p class="text-[1.05rem] leading-[1.35] max-w-[22rem]">
        {t.work.subtitle}
      </p>
    </header>

    <div class="border-t border-[#dcdcd7]">
      <article
        class="cs-reveal grid grid-cols-[minmax(15rem,0.62fr)_minmax(0,1.8fr)] gap-[clamp(2rem,5vw,6rem)] py-5 items-stretch border-b border-[#dcdcd7] max-[900px]:grid-cols-1"
      >
        <div class={projectCopyClass}>
          <span class={projectNumberClass}>{projectNumbers.minqik}</span>
          <h3 class={projectTitleClass}>{projects.minqik.title}</h3>
          <p class={projectTypeClass}>
            {projects.minqik.category}<br />{projects.minqik.discipline}
          </p>
          <p class={projectDescriptionClass}>{projects.minqik.description}</p>
        </div>
        <div
          class={`${visualClass} bg-[#dcd6ff] flex items-center justify-center max-[600px]:p-3`}
        >
          <img
            src={minqikImage.src}
            width={minqikImage.width}
            height={minqikImage.height}
            alt={projects.minqik.title}
            loading="lazy"
            decoding="async"
            class={imageClass}
          />
        </div>
      </article>

      <article
        class="cs-reveal grid grid-cols-[minmax(0,1.8fr)_minmax(15rem,0.62fr)] gap-[clamp(2rem,5vw,6rem)] py-5 items-stretch border-b border-[#dcdcd7] max-[900px]:grid-cols-1"
      >
        <div
          class={`${visualClass} bg-[#eeeee9] flex items-center justify-center max-[900px]:order-2 max-[600px]:p-3`}
        >
          <img
            src={parqueameImage.src}
            width={parqueameImage.width}
            height={parqueameImage.height}
            alt={projects.papp.title}
            loading="lazy"
            decoding="async"
            class={imageClass}
          />
        </div>
        <div class={`${projectCopyClass} max-[900px]:order-1`}>
          <span class={projectNumberClass}>{projectNumbers.papp}</span>
          <h3 class={projectTitleClass}>{projects.papp.title}</h3>
          <p class={projectTypeClass}>
            {projects.papp.category}<br />{projects.papp.discipline}
          </p>
          <p class={projectDescriptionClass}>{projects.papp.description}</p>
        </div>
      </article>

      <article
        class="cs-reveal my-5 min-h-[31rem] grid grid-cols-[minmax(16rem,0.62fr)_1.5fr] bg-[#101010] text-white rounded-lg overflow-hidden max-[900px]:grid-cols-1 max-[600px]:-mx-4 max-[600px]:rounded-none"
      >
        <div
          class="p-12 flex flex-col items-start max-[600px]:px-6 max-[600px]:py-10"
        >
          <span class={projectNumberClass}>{projectNumbers.coopcibao}</span>
          <h3 class={projectTitleClass}>{projects.coopcibao.title}</h3>
          <p class="text-[#aaa] text-base leading-[1.3]">
            {projects.coopcibao.category}<br />{projects.coopcibao.discipline}
          </p>
          <p class="max-w-[28rem] text-[#aaa] leading-[1.55] mt-auto pt-8">
            {projects.coopcibao.description}
          </p>
        </div>
        <div
          class="relative overflow-hidden border-l border-[#444] max-[900px]:min-h-[25rem] max-[900px]:border-l-0 max-[900px]:border-t max-[900px]:border-[#444]"
          aria-hidden="true"
        >
          <div
            class="absolute size-[25rem] border-[5rem] border-[#2f9b69] rounded-full left-[20%] top-[14%]"
          >
          </div>
          <div
            class="absolute size-44 rounded-full bg-[#f0eadb] left-[10%] bottom-[9%] border-[1rem] border-double border-[#111]"
          >
          </div>
          <div class="absolute size-28 bg-[#f4eee4] left-[15%] top-[10%]"></div>
          <div
            class="absolute w-60 h-40 right-12 bottom-12 bg-[repeating-linear-gradient(90deg,#e8e3d1_0_2px,transparent_2px_7px)] [clip-path:polygon(0_0,100%_40%,100%_100%,0_70%)]"
          >
          </div>
          <div
            class="absolute right-[15%] top-[12%] font-display text-9xl font-bold text-[#2f9b69] mix-blend-screen"
          >
            C
          </div>
        </div>
      </article>

      <div
        class="grid grid-cols-2 border-b border-[#dcdcd7] max-[900px]:grid-cols-1"
      >
        <article
          class="cs-reveal p-10 pb-12 border-r border-[#dcdcd7] max-[900px]:border-r-0 max-[900px]:border-b max-[900px]:border-[#dcdcd7] max-[600px]:px-0"
        >
          <div class="flex flex-col items-start">
            <span
              class="font-display text-[clamp(4.5rem,7vw,7rem)] leading-[0.8] tracking-[-0.06em] text-[var(--color-accent)] font-light mb-6"
              >{projectNumbers.kulkul}</span
            >
            <h3
              class="font-display text-[clamp(2.2rem,3.5vw,3.6rem)] leading-[0.95] tracking-[-0.04em] font-semibold mb-4"
            >
              {projects.kulkul.title}
            </h3>
            <p class={projectTypeClass}>
              {projects.kulkul.category} / {projects.kulkul.discipline}
            </p>
          </div>
          <div
            class="h-80 my-8 relative overflow-hidden rounded-md bg-[#eee9df]"
            aria-hidden="true"
          >
            <i
              class="absolute w-48 h-28 rounded-[100%_0_100%_0] -rotate-[30deg] bg-[#ef4f35] left-[14%] top-[12%]"
            ></i>
            <i
              class="absolute w-48 h-28 rounded-[100%_0_100%_0] -rotate-[30deg] bg-[#357c54] left-[34%] top-[28%]"
            ></i>
            <i
              class="absolute size-20 rounded-full bg-[#d9c19d] right-[10%] bottom-[12%]"
            ></i>
            <i
              class="absolute left-[8%] bottom-[14%] w-36 h-16 bg-[repeating-radial-gradient(ellipse_at_50%_100%,transparent_0_10px,#111_11px_12px,transparent_13px_20px)]"
            ></i>
            <i
              class="absolute right-[12%] top-[12%] size-20 bg-[radial-gradient(#111_1.5px,transparent_2px)] bg-[length:14px_14px]"
            ></i>
          </div>
          <p class="max-w-[28rem] text-[#666] leading-[1.55]">
            {projects.kulkul.description}
          </p>
        </article>

        <article class="cs-reveal p-10 pb-12 max-[600px]:px-0">
          <div class="flex flex-col items-start">
            <span
              class="font-display text-[clamp(4.5rem,7vw,7rem)] leading-[0.8] tracking-[-0.06em] text-[var(--color-accent)] font-light mb-6"
              >{projectNumbers.lda}</span
            >
            <h3
              class="font-display text-[clamp(2.2rem,3.5vw,3.6rem)] leading-[0.95] tracking-[-0.04em] font-semibold mb-4"
            >
              {projects.lda.title}
            </h3>
            <p class={projectTypeClass}>
              {projects.lda.category} / {projects.lda.discipline}
            </p>
          </div>
          <div
            class="h-80 my-8 relative overflow-hidden rounded-md bg-[#111]"
            aria-hidden="true"
          >
            <div
              class="absolute left-1/2 top-0 h-full w-px border border-[#eee]"
            >
              <span
                class="absolute top-1/2 left-1/2 size-32 -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#eee]"
              ></span>
            </div>
            <div
              class="absolute left-0 top-1/4 w-[24%] h-1/2 border border-[#eee]"
            >
            </div>
            <div
              class="absolute right-0 top-1/4 w-[24%] h-1/2 border border-[#eee]"
            >
            </div>
            <i
              class="absolute left-[18%] bottom-[24%] size-3 rounded-full bg-[#f8543b] border-2 border-white z-[2]"
            ></i>
            <i
              class="absolute left-[52%] top-[38%] size-3 rounded-full bg-[#f8543b] border-2 border-white z-[2]"
            ></i>
            <i
              class="absolute right-[16%] top-[18%] size-3 rounded-full bg-[#f8543b] border-2 border-white z-[2]"
            ></i>
            <svg viewBox="0 0 300 180" class="absolute inset-0 size-full"
              ><path
                d="M48 132 C92 112 102 52 154 78 S218 124 254 38"
                class="fill-none stroke-[#f8543b] stroke-[3] [stroke-dasharray:8_6]"
              ></path></svg
            >
          </div>
          <p class="max-w-[28rem] text-[#666] leading-[1.55]">
            {projects.lda.description}
          </p>
        </article>
      </div>

      <article
        class="cs-reveal grid grid-cols-[minmax(0,1.8fr)_minmax(15rem,0.62fr)] gap-[clamp(2rem,5vw,6rem)] py-5 items-stretch border-b border-[#dcdcd7] max-[900px]:grid-cols-1"
      >
        <div
          class={`${visualClass} bg-white border border-[#ddd] max-[900px]:order-2`}
          aria-hidden="true"
        >
          <div
            class="h-14 border-b border-[#ddd] flex items-center gap-3 px-5 text-[0.65rem]"
          >
            <i class="size-2 rounded-full bg-[#f8543b]"></i><i
              class="size-2 rounded-full bg-[#f4bb42]"></i><i
              class="size-2 rounded-full bg-[#47b976]"></i><b
              class="text-base ml-4 mr-auto">BCI</b
            ><span class="ml-4 max-[600px]:hidden">Vehicles</span><span
              class="ml-4 max-[600px]:hidden">About</span
            ><span class="ml-4 max-[600px]:hidden">Contact</span>
          </div>
          <div
            class="absolute left-10 top-[7.5rem] z-[2] flex flex-col items-start gap-5"
          >
            <strong
              class="text-[clamp(2rem,4vw,4rem)] leading-[0.9] tracking-[-0.05em]"
              >Drive what's<br />next.</strong
            ><span class="h-[3px] w-16 bg-[#f8543b]"></span><i
              class="bg-[#111] text-white px-4 py-3 text-xs rounded"
              >Explore vehicles</i
            >
          </div>
          <div
            class="absolute right-0 bottom-0 w-[57%] h-3/4 flex items-end origin-bottom-right skew-y-[-8deg] max-[600px]:w-[68%]"
          >
            <i class="h-[70%] flex-1 bg-[#214db5] border border-white/50"></i><i
              class="h-full flex-1 bg-[#4072e0] border border-white/50"></i><i
              class="h-[84%] flex-1 bg-[#102d71] border border-white/50"></i>
          </div>
        </div>
        <div class={`${projectCopyClass} max-[900px]:order-1`}>
          <span class={projectNumberClass}>{projectNumbers.bci}</span>
          <h3 class={projectTitleClass}>{projects.bci.title}</h3>
          <p class={projectTypeClass}>
            {projects.bci.category}<br />{projects.bci.discipline}
          </p>
          <p class={projectDescriptionClass}>{projects.bci.description}</p>
        </div>
      </article>
    </div>

    <article
      class="cs-reveal mt-24 min-h-[34rem] grid grid-cols-[0.72fr_1.45fr] overflow-hidden rounded-[0.6rem] bg-[#101010] text-white max-[900px]:grid-cols-1 max-[600px]:-mx-4 max-[600px]:rounded-none"
    >
      <div
        class="p-16 flex flex-col items-start max-[600px]:px-6 max-[600px]:py-12"
      >
        <span class="mb-10 text-[0.65rem] font-bold uppercase tracking-[0.15em]"
          ><i
            class="mr-2 inline-block size-2 rounded-full bg-[var(--color-accent)]"
          ></i>
          {billing.label}</span
        >
        <h3
          class="font-display text-[clamp(3.3rem,5vw,5.5rem)] leading-[0.9] tracking-[-0.055em] mb-5"
        >
          {billing.title}
        </h3>
        <p class="text-[var(--color-accent)] font-semibold mb-8">
          {billing.type}
        </p>
        <p
          class="text-[#aaa] leading-[1.55] max-w-[22rem] mt-auto max-[900px]:mt-4"
        >
          {billing.description}
        </p>
      </div>
      <div
        class="mt-10 grid grid-cols-[10rem_1fr] overflow-hidden rounded-tl-2xl border border-[#3b3b3b] bg-[#181818] max-[900px]:mx-6 max-[900px]:mt-0 max-[900px]:min-h-[25rem] max-[900px]:rounded-t-2xl max-[600px]:mx-3 max-[600px]:grid-cols-[5.5rem_1fr]"
      >
        <aside
          class="border-r border-[#333] p-6 flex flex-col gap-2 max-[600px]:px-3"
        >
          <b class="mb-8 text-xl">KB</b><span
            class="rounded-md bg-[#f8543b33] p-3 text-[0.65rem] text-white max-[600px]:px-1.5 max-[600px]:text-[0.55rem]"
            >{billing.overview}</span
          ><span
            class="rounded-md p-3 text-[0.65rem] text-[#888] max-[600px]:px-1.5 max-[600px]:text-[0.55rem]"
            >{billing.invoices}</span
          ><span
            class="rounded-md p-3 text-[0.65rem] text-[#888] max-[600px]:px-1.5 max-[600px]:text-[0.55rem]"
            >{billing.customers}</span
          ><span
            class="rounded-md p-3 text-[0.65rem] text-[#888] max-[600px]:px-1.5 max-[600px]:text-[0.55rem]"
            >{billing.reports}</span
          ><span
            class="rounded-md p-3 text-[0.65rem] text-[#888] max-[600px]:px-1.5 max-[600px]:text-[0.55rem]"
            >{billing.settings}</span
          >
        </aside>
        <div class="p-6">
          <div class="flex items-center justify-between">
            <strong>{billing.overview}</strong><i
              class="rounded bg-[var(--color-accent)] px-3 py-2 text-[0.6rem]"
              >{billing.newInvoice}</i
            >
          </div><div
            class="my-7 grid grid-cols-3 gap-3 max-[600px]:grid-cols-2"
          >
            <span
              class="h-[5.5rem] rounded-lg border border-[#333] bg-[linear-gradient(145deg,#242424,#1b1b1b)]"
            ></span><span
              class="h-[5.5rem] rounded-lg border border-[#333] bg-[linear-gradient(145deg,#242424,#1b1b1b)]"
            ></span><span
              class="h-[5.5rem] rounded-lg border border-[#333] bg-[linear-gradient(145deg,#242424,#1b1b1b)] max-[600px]:hidden"
            ></span>
          </div><div>
            <b class="text-sm">{billing.recentInvoices}</b><i
              class="block h-11 border-b border-[#303030] after:block after:w-[65%] after:h-2 after:translate-y-5 after:rounded-full after:bg-[#343434]"
            ></i><i
              class="block h-11 border-b border-[#303030] after:block after:w-[65%] after:h-2 after:translate-y-5 after:rounded-full after:bg-[#343434]"
            ></i><i
              class="block h-11 border-b border-[#303030] after:block after:w-[65%] after:h-2 after:translate-y-5 after:rounded-full after:bg-[#343434]"
            ></i><i
              class="block h-11 border-b border-[#303030] after:block after:w-[65%] after:h-2 after:translate-y-5 after:rounded-full after:bg-[#343434]"
            ></i>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  requestAnimationFrame(() => {
    gsap.utils.toArray<HTMLElement>(".cs-reveal").forEach((element) => {
      gsap.to(element, {
        scrollTrigger: { trigger: element, start: "top 88%", once: true },
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: "power3.out",
      });
    });
  });
</script>
