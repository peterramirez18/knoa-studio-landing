---
import type { Dictionary } from "../i18n";
import { Image } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import minqikImage from "../assets/projects/minqik.png";
import parqueameImage from "../assets/projects/parqueameapp.png";
import bciImage from "../assets/projects/bci.png";
import reinasVideo from "../assets/projects/REINAS.mp4";
import ldaVideo from "../assets/projects/BUMPER LDF 1.mp4";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const projectNumbers = {
  minqik: "01",
  papp: "02",
  bci: "03",
  reinas: "04",
  coopcibao: "05",
  lda: "06",
};
const projects = t.work.projects;
const splitLastWord = (value: string) => {
  const words = value.trim().split(/\s+/);
  return {
    before: words.slice(0, -1).join(" "),
    accent: words.at(-1) ?? "",
  };
};
const workHeading = splitLastWord(t.work.title);
const billing = t.work.billing;
const coopcibaoVideo = "/video-placeholder.mp4";
const projectNumberClass =
  "font-display text-sm leading-normal tracking-normal text-[var(--color-accent)] font-medium mb-5";
const projectTitleClass =
  "font-display text-3xl lg:text-4xl leading-[1.15] tracking-normal font-medium mb-3";
const projectTypeClass = "text-[#555] text-base leading-[1.3]";
const projectDescriptionClass =
  "max-w-[28rem] text-[#666] text-sm leading-relaxed mt-auto pt-6 max-[900px]:mt-0";
const projectCopyClass =
  "py-6 flex flex-col items-start max-[900px]:pb-0";
const visualClass =
  "aspect-[16/10] min-w-0 relative overflow-hidden rounded-lg";
const imageClass =
  "h-full w-full object-cover";
const videoClass =
  "h-full w-full object-cover";
const viewProjectLabel = t.nav.cta === "Hablemos" ? "Ver proyecto" : "View project";
const viewVideoLabel = t.nav.cta === "Hablemos" ? "Ver video" : "Watch video";
const actionOverlayClass =
  "pointer-events-none absolute inset-0 flex items-end justify-end bg-black/0 p-5 opacity-0 transition-all duration-300 group-hover:bg-black/25 group-hover:opacity-100 group-focus-visible:bg-black/25 group-focus-visible:opacity-100";
const actionButtonClass =
  "relative isolate inline-flex min-h-11 items-center justify-center overflow-hidden rounded-full border border-white bg-white px-5 py-2 text-sm font-medium text-black transition-colors duration-500 group-hover:border-transparent group-hover:text-white group-focus-visible:border-transparent group-focus-visible:text-white";
const actionButtonFillClass =
  "absolute inset-0 z-0 h-full w-full -translate-y-full rounded-full bg-[var(--color-accent)] transition-transform duration-500 ease-[cubic-bezier(0.76,0,0.24,1)] group-hover:translate-y-0 group-focus-visible:translate-y-0";
const oneVisual = t.nav.cta === "Hablemos"
  ? { invoices: "Facturas", clients: "Clientes", inventory: "Inventario", month: "Septiembre 2026", issue: "Emitir e-CF", sales: "Ventas del mes", due: "Por cobrar", issued: "e-CF emitidos", customer: "Cliente", amount: "Monto", accepted: "Aceptado", status: "e-CF aceptado por la DGII" }
  : { invoices: "Invoices", clients: "Customers", inventory: "Inventory", month: "September 2026", issue: "Issue e-CF", sales: "Monthly sales", due: "Receivables", issued: "e-CF issued", customer: "Customer", amount: "Amount", accepted: "Accepted", status: "e-CF accepted by DGII" };
---

<section
  id="case-studies"
  class="bg-[#f5f5f5] px-6 py-20 lg:py-28 overflow-hidden lg:px-8"
>
  <div class="max-w-6xl mx-auto lg:px-8">
    <header
      class="cs-reveal grid grid-cols-[minmax(0,1fr)_3rem_minmax(15rem,22rem)] items-center gap-8 mb-12 max-[900px]:grid-cols-1 max-[900px]:gap-5"
    >
      <SectionHeading before={workHeading.before} accent={workHeading.accent} />
      <span class="h-px bg-[#a9a9a5] max-[900px]:w-20" aria-hidden="true"
      ></span>
      <p class="text-[1.05rem] leading-[1.35] max-w-[22rem]">
        {t.work.subtitle}
      </p>
    </header>

    <div>
      <article
        id="project-minqik"
        class="cs-reveal scroll-mt-28 grid grid-cols-[minmax(15rem,0.62fr)_minmax(0,1.8fr)] gap-[clamp(2rem,5vw,6rem)] py-5 items-stretch max-[900px]:grid-cols-1"
      >
        <div class={projectCopyClass}>
          <span class={projectNumberClass}>{projectNumbers.minqik}</span>
          <h3 class={projectTitleClass}>{projects.minqik.title}</h3>
          <p class={projectTypeClass}>
            {projects.minqik.category}<br />{projects.minqik.discipline}
          </p>
          <p class={projectDescriptionClass}>{projects.minqik.description}</p>
        </div>
        <a
          href="https://www.minqik.com"
          target="_blank"
          rel="noopener noreferrer"
          class={`${visualClass} group cursor-pointer bg-[#dcd6ff] flex items-center justify-center max-[600px]:p-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-4`}
          aria-label={`${viewProjectLabel}: ${projects.minqik.title}`}
        >
          <Image
            src={minqikImage}
            alt={projects.minqik.title}
            loading="lazy"
            decoding="async"
            class={imageClass}
          />
          <span class={actionOverlayClass}>
            <span class={actionButtonClass}>
              <span class={actionButtonFillClass}></span>
              <span class="relative z-10">{viewProjectLabel}</span>
            </span>
          </span>
        </a>
      </article>

      <article
        id="project-papp"
        class="cs-reveal scroll-mt-28 grid grid-cols-[minmax(0,1.8fr)_minmax(15rem,0.62fr)] gap-[clamp(2rem,5vw,6rem)] py-5 items-stretch max-[900px]:grid-cols-1"
      >
        <a
          href="https://www.parqueameapp.com"
          target="_blank"
          rel="noopener noreferrer"
          class={`${visualClass} group cursor-pointer bg-[#eeeee9] flex items-center justify-center max-[900px]:order-2 max-[600px]:p-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-4`}
          aria-label={`${viewProjectLabel}: ${projects.papp.title}`}
        >
          <Image
            src={parqueameImage}
            alt={projects.papp.title}
            loading="lazy"
            decoding="async"
            class={imageClass}
          />
          <span class={actionOverlayClass}>
            <span class={actionButtonClass}>
              <span class={actionButtonFillClass}></span>
              <span class="relative z-10">{viewProjectLabel}</span>
            </span>
          </span>
        </a>
        <div class={`${projectCopyClass} max-[900px]:order-1`}>
          <span class={projectNumberClass}>{projectNumbers.papp}</span>
          <h3 class={projectTitleClass}>{projects.papp.title}</h3>
          <p class={projectTypeClass}>
            {projects.papp.category}<br />{projects.papp.discipline}
          </p>
          <p class={projectDescriptionClass}>{projects.papp.description}</p>
        </div>
      </article>

      <article
        id="project-bci"
        class="cs-reveal scroll-mt-28 grid grid-cols-[minmax(15rem,0.62fr)_minmax(0,1.8fr)] gap-[clamp(2rem,5vw,6rem)] py-5 items-stretch max-[900px]:grid-cols-1"
      >
        <div class={projectCopyClass}>
          <span class={projectNumberClass}>{projectNumbers.bci}</span>
          <h3 class={projectTitleClass}>{projects.bci.title}</h3>
          <p class={projectTypeClass}>{projects.bci.category}<br />{projects.bci.discipline}</p>
          <p class={projectDescriptionClass}>{projects.bci.description}</p>
        </div>
        <a
          href="https://bci.com.do"
          target="_blank"
          rel="noopener noreferrer"
          class={`${visualClass} group cursor-pointer bg-white flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-4`}
          aria-label={`${viewProjectLabel}: ${projects.bci.title}`}
        >
          <Image src={bciImage} alt={projects.bci.title} loading="lazy" decoding="async" class={imageClass} />
          <span class={actionOverlayClass}>
            <span class={actionButtonClass}>
              <span class={actionButtonFillClass}></span>
              <span class="relative z-10">{viewProjectLabel}</span>
            </span>
          </span>
        </a>
      </article>

      <article
        id="project-reinas"
        class="cs-reveal my-5 scroll-mt-28 min-h-[31rem] grid grid-cols-[minmax(16rem,0.62fr)_1.5fr] bg-[#101010] text-white rounded-lg overflow-hidden max-[900px]:grid-cols-1 max-[600px]:-mx-4 max-[600px]:rounded-none"
      >
        <div
          class="p-12 flex flex-col items-start max-[600px]:px-6 max-[600px]:py-10"
        >
          <span class={projectNumberClass}>{projectNumbers.reinas}</span>
          <h3 class={projectTitleClass}>{projects.reinas.title}</h3>
          <p class="text-[#aaa] text-base leading-[1.3]">
            {projects.reinas.category}<br />{projects.reinas.discipline}
          </p>
          <p class="max-w-[28rem] text-[#aaa] leading-[1.55] mt-auto pt-8">
            {projects.reinas.description}
          </p>
        </div>
        <button
          type="button"
          class="group relative h-full w-full cursor-pointer overflow-hidden text-left max-[900px]:min-h-[25rem] max-[900px]:border-[#444] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-inset"
          data-video-modal-open
          data-video-src={reinasVideo}
          data-video-title={projects.reinas.title}
          aria-label={`${viewVideoLabel}: ${projects.reinas.title}`}
        >
          <video
            data-lazy-src={reinasVideo}
            class="h-full w-full object-cover"
            loop
            muted
            playsinline
            preload="none"></video>
          <span class={actionOverlayClass}>
            <span class={actionButtonClass}>
              <span class={actionButtonFillClass}></span>
              <span class="relative z-10">{viewVideoLabel}</span>
            </span>
          </span>
        </button>
      </article>

      <div class="grid grid-cols-2 max-[900px]:grid-cols-1 gap-10">
        <article
          id="project-coopcibao"
          class="cs-reveal scroll-mt-28 pb-12 max-[900px]:border-r-0 max-[900px]:border-b max-[900px]:border-[#dcdcd7] max-[600px]:px-0"
        >
          <div class="flex flex-col items-start">
            <span
              class={projectNumberClass}
              >{projectNumbers.coopcibao}</span
            >
            <h3
              class={projectTitleClass}
            >
              {projects.coopcibao.title}
            </h3>
            <p class={projectTypeClass}>
              {projects.coopcibao.category} / {projects.coopcibao.discipline}
            </p>
          </div>
          <button
            type="button"
            class="group aspect-video my-6 relative w-full cursor-pointer overflow-hidden rounded-md bg-[#101010] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-4"
            data-video-modal-open
            data-video-src={coopcibaoVideo}
            data-video-title={projects.coopcibao.title}
            aria-label={`${viewVideoLabel}: ${projects.coopcibao.title}`}
          >
            <video
              data-lazy-src={coopcibaoVideo}
              class={videoClass}
              loop
              muted
              playsinline
              preload="none"></video>
            <span class={actionOverlayClass}>
              <span class={actionButtonClass}>
                <span class={actionButtonFillClass}></span>
                <span class="relative z-10">{viewVideoLabel}</span>
              </span>
            </span>
          </button>
          <p class="max-w-[28rem] text-[#666] leading-[1.55]">
            {projects.coopcibao.description}
          </p>
        </article>

        <article id="project-lda" class="cs-reveal scroll-mt-28 pb-12 max-[600px]:px-0">
          <div class="flex flex-col items-start">
            <span
              class={projectNumberClass}
              >{projectNumbers.lda}</span
            >
            <h3
              class={projectTitleClass}
            >
              {projects.lda.title}
            </h3>
            <p class={projectTypeClass}>
              {projects.lda.category} / {projects.lda.discipline}
            </p>
          </div>
          <button
            type="button"
            class="group aspect-video my-6 relative w-full cursor-pointer overflow-hidden rounded-md bg-[#101010] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-4"
            data-video-modal-open
            data-video-src={ldaVideo}
            data-video-title={projects.lda.title}
            aria-label={`${viewVideoLabel}: ${projects.lda.title}`}
          >
            <video
              data-lazy-src={ldaVideo}
              class={videoClass}
              loop
              muted
              playsinline
              preload="none"></video>
            <span class={actionOverlayClass}>
              <span class={actionButtonClass}>
                <span class={actionButtonFillClass}></span>
                <span class="relative z-10">{viewVideoLabel}</span>
              </span>
            </span>
          </button>
          <p class="max-w-[28rem] text-[#666] leading-[1.55]">
            {projects.lda.description}
          </p>
        </article>
      </div>

    </div>

    <article
      id="project-knoa-one"
      class="cs-reveal scroll-mt-28 mt-16 grid grid-cols-[0.72fr_1.45fr] overflow-hidden rounded-lg border border-[#e5e7eb] bg-white text-[#0a0a0b] max-[900px]:grid-cols-1"
    >
      <div
        class="p-10 flex flex-col items-start max-[600px]:p-6"
      >
        <span class="mb-10 text-[0.65rem] font-medium uppercase tracking-[0.15em] text-[#2678c3]"
          ><i
            class="mr-2 inline-block size-2 rounded-full bg-[#168ee2]"
          ></i>
          {billing.label}</span
        >
        <img src="/knoaone.svg" alt="" width="240" height="34" loading="lazy" class="mb-8 h-auto w-48" />
        <h3 class="sr-only">{billing.title}</h3>
        <p class="mb-6 text-lg font-medium leading-snug text-[#0a0a0b]">
          {billing.type}
        </p>
        <p
          class="mt-auto max-w-[22rem] leading-relaxed text-[#666] max-[900px]:mt-0"
        >
          {billing.description}
        </p>
      </div>
      <a
        href="https://one.knoastudio.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="group relative mt-8 flex min-w-0 cursor-pointer items-center overflow-hidden rounded-tl-lg bg-[#f7f9fb] p-5 max-[900px]:mx-6 max-[900px]:mt-0 max-[900px]:rounded-t-lg max-[600px]:mx-3 max-[600px]:p-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] focus-visible:ring-offset-4"
        aria-label={`${viewProjectLabel}: ${billing.title}`}
      >
        <div class="relative w-full min-w-0 overflow-hidden rounded-lg border border-[#e6e8eb] bg-white shadow-[0_14px_35px_rgba(26,42,62,0.08)]">
          <div class="flex items-center gap-2 border-b border-[#e6e8eb] bg-[#fafafa] px-4 py-2">
            <span class="size-1.5 rounded-full bg-[#d6d9dd]"></span>
            <span class="size-1.5 rounded-full bg-[#d6d9dd]"></span>
            <span class="size-1.5 rounded-full bg-[#d6d9dd]"></span>
            <span class="mx-auto text-[0.65rem] text-[#9b9fa7]">app.one.knoastudio.com / facturas</span>
          </div>
          <div class="flex min-w-0">
            <div class="hidden w-32 shrink-0 border-r border-[#e6e8eb] p-3 text-[0.7rem] text-[#81858d] sm:block">
              <p class="mb-4 font-semibold text-[#0a0a0b]">Knoa</p>
              <p class="mb-2">Dashboard</p>
              <p class="mb-2 rounded bg-[#eaf4fd] px-2 py-1 font-semibold text-[#1b6eaf]">{oneVisual.invoices}</p>
              <p class="mb-2">{oneVisual.clients}</p>
              <p>{oneVisual.inventory}</p>
            </div>
            <div class="min-w-0 flex-1 p-3 sm:p-5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <p class="text-[0.65rem] text-[#9b9fa7]">{oneVisual.month}</p>
                  <p class="text-sm font-semibold text-[#0a0a0b]">{oneVisual.invoices}</p>
                </div>
                <span class="rounded bg-[#0a0a0b] px-2.5 py-1.5 text-[0.65rem] font-medium text-white">+ {oneVisual.issue}</span>
              </div>
              <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3">
                {[
                  { label: oneVisual.sales, value: "RD$ 1.28M", detail: "+12.4%", tone: "text-[#13866d]" },
                  { label: oneVisual.due, value: "RD$ 342K", detail: "18", tone: "text-[#8b8e95]" },
                  { label: oneVisual.issued, value: "1,204", detail: "100%", tone: "text-[#13866d]" },
                ].map((metric, index) => (
                  <div class:list={["min-w-0 rounded border border-[#e6e8eb] p-2.5", index === 2 && "col-span-2 sm:col-span-1"]}>
                    <p class="text-[0.6rem] text-[#8b8e95]">{metric.label}</p>
                    <p class="mt-1 text-base font-semibold text-[#0a0a0b] sm:text-lg">{metric.value}</p>
                    <p class:list={["text-[0.6rem]", metric.tone]}>{metric.detail}</p>
                  </div>
                ))}
              </div>
              <div class="mt-4 overflow-hidden rounded border border-[#e6e8eb] text-[0.65rem]">
                <div class="grid grid-cols-[1fr_auto_auto] gap-2 bg-[#fafafa] px-3 py-2 font-medium uppercase text-[#8b8e95]">
                  <span>{oneVisual.customer}</span><span>{oneVisual.amount}</span><span>DGII</span>
                </div>
                {[
                  { customer: "Ferretería Olivo SRL", amount: "RD$ 48,560" },
                  { customer: "Consumidor final", amount: "RD$ 3,245" },
                  { customer: "Grupo Almonte", amount: "RD$ 125,900" },
                ].map((invoice) => (
                  <div class="grid grid-cols-[1fr_auto_auto] items-center gap-2 border-t border-[#e6e8eb] px-3 py-2.5">
                    <span class="min-w-0 truncate text-[#303237]">{invoice.customer}</span>
                    <span class="whitespace-nowrap text-[#303237]">{invoice.amount}</span>
                    <span class="size-2 rounded-full bg-[#28b98e]" title={oneVisual.accepted}></span>
                  </div>
                ))}
              </div>
            </div>
          </div>
          <div class="flex items-center gap-2 border-t border-[#e6e8eb] bg-[#f6fffb] px-4 py-2 text-[0.65rem] font-medium text-[#13866d]"><span class="size-1.5 rounded-full bg-[#28b98e]"></span>{oneVisual.status}</div>
        </div>
        <span class={actionOverlayClass}>
          <span class={actionButtonClass}>
            <span class={actionButtonFillClass}></span>
            <span class="relative z-10">{viewProjectLabel}</span>
          </span>
        </span>
      </a>
    </article>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  requestAnimationFrame(() => {
    gsap.utils.toArray<HTMLElement>(".cs-reveal").forEach((element) => {
      gsap.to(element, {
        scrollTrigger: { trigger: element, start: "top 88%", once: true },
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: "power3.out",
      });
    });
  });

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const lazyVideos = document.querySelectorAll<HTMLVideoElement>("video[data-lazy-src]");
  const videoObserver = new IntersectionObserver(
    (entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const video = entry.target as HTMLVideoElement;
        const src = video.dataset.lazySrc;
        if (src) {
          video.src = src;
          video.load();
          if (!reducedMotion) video.play().catch(() => undefined);
        }
        observer.unobserve(video);
      });
    },
    { rootMargin: "300px" },
  );
  lazyVideos.forEach((video) => videoObserver.observe(video));
</script>
