---
import type { Dictionary } from "../i18n";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section id="about" class="relative py-20 lg:py-28 bg-white overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-16">
      <div class="lg:col-span-5 about-left opacity-0 translate-y-12">
        <SectionHeading before={t.about.titleBefore} accent={t.about.titleAccent} after={t.about.titleAfter} class="mb-4" />
        <h3 class="font-sans text-base sm:text-lg text-[var(--color-text-secondary)] font-normal mb-4">
          {t.about.subtitle}
        </h3>
      </div>

      <div class="lg:col-span-7 flex flex-col justify-center about-right opacity-0 translate-y-12">
        <div class="text-base text-[var(--color-text-secondary)] leading-relaxed max-w-none">
          <p class="mb-5 text-lg lg:text-xl text-[var(--color-text)] leading-relaxed">
            {t.about.paragraph1}
          </p>
          <p>{t.about.paragraph2}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  requestAnimationFrame(() => {
    const tl = gsap.timeline({
      scrollTrigger: { trigger: "#about", start: "top 75%", toggleActions: "play none none none", once: true },
    });

    tl.to(".about-left", { opacity: 1, y: 0, duration: 1, ease: "power3.out" }).to(
      ".about-right",
      { opacity: 1, y: 0, duration: 1, ease: "power3.out" },
      "-=0.6",
    );
  });
</script>
